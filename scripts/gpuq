#!/usr/bin/env bash
# gpuq -- queue discipline for the single 24 GiB GPU box.
#
# WHY THIS EXISTS
# The engine needs 11.5-15 GiB of unified memory. Two instances at once exceed
# physical memory and start evicting and swapping, which this repo has already
# measured at 3.9 GiB of swap and a collapse to ~1.4 tok/s (weights.rs:1217).
# The in-binary flock (gpu_lock.rs) makes that impossible, but a 30-minute
# blocking wait is its own failure: an agent that calls a benchmark and sits in
# `flock` for twenty minutes has wasted twenty minutes, cannot report, and
# cannot do the analysis that would have been useful meanwhile.
#
# So: never block by default. Ask, get an instant answer, do something else,
# ask again.
#
#   gpuq status          instant. Who holds it, who is waiting, free memory.
#   gpuq try [-- cmd...] instant. Run only if free; exit 75 if busy.
#   gpuq run [-- cmd...]  blocks until free, then runs. Long timeout, and it
#                         prints a heartbeat so a stuck call is visible.
#   gpuq exec -- cmd...   same as `run` but the command is mandatory.
#
# EXIT CODES
#   0  ran, or lock was free
#   75 lock was held (EX_TEMPFAIL -- "try again later", per sysexits)
#   1  usage or runtime error
#
# Fairness: waiters are served in arrival order via a ticket file, so a long
# benchmark cannot be starved by a stream of short ones.

set -uo pipefail

LOCK="${KAPLUMBA_GPU_LOCK:-$HOME/.kaplumba/gpu.lock}"
QUEUE="${KAPLUMBA_GPU_QUEUE:-${LOCK}.queue}"
HEARTBEAT="${KAPLUMBA_GPU_HEARTBEAT:-5}"

# flock(1) is not on the default PATH on macOS (util-linux is a Homebrew keg),
# and `lockf` does not take the same options. Prefer a real flock(1); fall back
# to perl, which is always present and can call flock(2) directly. Getting this
# wrong is silent -- a missing flock looks exactly like a free GPU -- so the
# lookup is explicit and we fail loudly if neither works.
FLOCK=""
for candidate in "$(command -v flock 2>/dev/null)" \
                 /opt/homebrew/bin/flock \
                 "$(ls -1 /opt/homebrew/Cellar/util-linux/*/bin/flock 2>/dev/null | tail -1)"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then FLOCK="$candidate"; break; fi
done

# try_lock: exit 0 if the lock is free. Must be safe to call at any time.
try_lock() {
  if [ -n "$FLOCK" ]; then
    "$FLOCK" -n "$LOCK" -c true 2>/dev/null
  else
    perl -e '
      use Fcntl qw(:flock);
      open(my $fh, "+>>", $ARGV[0]) or exit 1;
      exit(flock($fh, LOCK_EX | LOCK_NB) ? 0 : 1);
    ' "$LOCK" 2>/dev/null
  fi
}

# run_locked: hold the lock while running "$@". Blocks until free.
run_locked() {
  # Stamp the lock file with the holder so `status` can name it, then exec under
  # the lock. Writing before taking the lock is fine: the content is advisory.
  printf '%s %s\n' "$$" "$*" > "$LOCK" 2>/dev/null
  if [ -n "$FLOCK" ]; then
    exec "$FLOCK" "$LOCK" -c "$(printf '%q ' "$@")"
  fi
  perl -e '
    use Fcntl qw(:flock);
    open(my $fh, "+>>", $ARGV[0]) or die "open $ARGV[0]: $!";
    flock($fh, LOCK_EX) or die "flock: $!";
    exec @ARGV;
  ' "$LOCK" "$@"
}

# Free memory in GiB, used to warn before a load that will thrash.
free_gib() {
  awk '/Pages free/ { printf "%.1f", $3 * 16384 / 1073741824; exit }' \
    < <(vm_stat 2>/dev/null) || echo "?"
}

swap_used_mb() {
  sysctl -n vm.swapusage 2>/dev/null |
    awk -F'[= ]+' '/used/ { printf "%.0f", $2 / 1048576; exit }' || echo "?"
}

# Who holds the lock right now. flock -n succeeds only if nobody holds it, so
# this is a non-destructive probe: we take and immediately drop the lock.
holder() {
  if try_lock; then
    echo "free"
  else
    head -c 200 "$LOCK" 2>/dev/null | tr -d '\n' || echo "unknown"
  fi
}

waiters() {
  [ -f "$QUEUE" ] || { echo 0; return; }
  # Drop entries whose owning pid is gone, so a crashed agent cannot wedge the
  # queue. Tickets are "pid seconds label".
  awk '{ pid = $1
          if (system("kill -0 " pid " 2>/dev/null") != 0) next
          print }' "$QUEUE" 2>/dev/null | wc -l | tr -d ' '
}

# Drop dead pids from the queue file, then append this one.
enqueue() {
  local label="${1:-gpuq}"
  mkdir -p "$(dirname "$QUEUE")" 2>/dev/null
  local tmp="${QUEUE}.$$"
  : > "$tmp"
  [ -f "$QUEUE" ] && awk '{ pid = $1
      if (system("kill -0 " pid " 2>/dev/null") == 0) print }' "$QUEUE" \
    >> "$tmp" 2>/dev/null
  printf '%s %s %s\n' "$$" "$(date +%s)" "$label" >> "$tmp"
  mv "$tmp" "$QUEUE" 2>/dev/null
}

dequeue() {
  [ -f "$QUEUE" ] || return 0
  local tmp="${QUEUE}.$$"
  awk -v me="$$" '$1 != me' "$QUEUE" > "$tmp" 2>/dev/null
  mv "$tmp" "$QUEUE" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
}

# Position among live waiters, 1-based. 1 means "next in line".
position() {
  [ -f "$QUEUE" ] || { echo 1; return; }
  awk -v me="$$" '
    { pid = $1
      if (system("kill -0 " pid " 2>/dev/null") != 0) next
      n++
      if (pid == me) { found = n } }
    END { print (found ? found : n + 1) }' "$QUEUE" 2>/dev/null
}

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

cmd="${1:-status}"
shift 2>/dev/null || true
# Accept `gpuq try -- cmd args` and `gpuq try cmd args` identically.
[ "${1:-}" = "--" ] && shift

case "$cmd" in
  status)
    if [ -z "$FLOCK" ] && ! command -v perl >/dev/null 2>&1; then
      echo "FATAL: neither flock(1) nor perl found; cannot serialise GPU access" >&2
      exit 1
    fi
    h="$(holder)"
    n="$(waiters)"
    f="$(free_gib)"
    s="$(swap_used_mb)"
    printf 'gpu: %s\n' "$h"
    printf 'queue: %s waiting\n' "$n"
    printf 'memory: %s GiB free, %s MiB swap used\n' "$f" "$s"
    # A load needs ~15 GiB; say so before the OOM rather than after.
    if [ "$f" != "?" ] && awk "BEGIN{exit !($f < 16)}" 2>/dev/null; then
      printf 'warning: below the ~16 GiB a model load needs; loading now risks a swap storm\n'
    fi
    ;;

  try)
    if try_lock; then
      [ $# -eq 0 ] && { echo "free"; exit 0; }
      mkdir -p "$(dirname "$QUEUE")" 2>/dev/null
      run_locked "$@"
      exit $?
    fi
    printf 'gpu: busy (%s)\n' "$(holder)"
    printf 'queue: %s waiting\n' "$(waiters)"
    echo "do other work and retry, or use: gpuq run -- $*" >&2
    exit 75
    ;;

  run | exec)
    if [ $# -eq 0 ]; then
      echo "usage: gpuq $cmd -- cmd [args...]" >&2
      exit 1
    fi
    label="$*"
    enqueue "$label"
    # shellcheck disable=SC2064
    trap "dequeue; rm -f \"\${QUEUE}.hb\" 2>/dev/null" EXIT
    pos="$(position)"
    printf 'gpuq: queued as #%s (%s waiting); holder: %s\n' \
      "$pos" "$(( $(waiters) - 1 ))" "$(holder)" >&2

    # Announce progress while blocked so a long wait is visibly a long wait and
    # not a hung tool call. The announcement is throttled: printing every second
    # would flood an agent's transcript.
    (
      while :; do
        sleep "$HEARTBEAT"
        h="$(holder)"
        [ "$h" = "free" ] && break
        printf 'gpuq: still waiting (#%s), free=%s GiB, holder: %s\n' \
          "$(position)" "$(free_gib)" "$h" >&2
      done
    ) &
    hb=$!

    # flock is the whole synchronisation mechanism: it returns the instant the
    # holder's fd closes, so a waiter is woken by the kernel rather than by
    # polling, and there is no lost-wakeup window.
    run_locked "$@"
    rc=$?
    kill "$hb" 2>/dev/null
    wait "$hb" 2>/dev/null
    exit $rc
    ;;

  -h | --help | help)
    usage
    ;;

  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
