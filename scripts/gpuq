#!/usr/bin/env bash
# gpuq -- report on, and gently wrap, the single 24 GiB GPU box.
#
# WHY THIS EXISTS
# The engine needs 11.5-15 GiB of unified memory. Two instances at once exceed
# physical memory and were measured swapping 3.9 GiB and collapsing to ~1.4
# tok/s (weights.rs:1217), and they also fight for bandwidth, which invalidates
# every benchmark taken alongside.
#
# THIS SCRIPT TAKES NO LOCK. The engine is the only lock owner
# (crates/engine/src/gpu_lock.rs, called from load_from_dir). An earlier version
# of this script took the same lock and then ran the engine, which DEADLOCKED:
#
#   #!/bin/bash
#   exec flock "$1" -c "flock '$1' -c 'echo CHILD-ACQUIRED'"
#   # hangs forever
#
# A lock held by a parent is not inherited as held by the child. The child's
# open() is a different open file description, so flock(LOCK_EX) conflicts with
# the parent's and blocks; the parent waits for the child and the child waits
# for the parent. It showed up as "gpuq try -- kaplumba" hanging forever while
# "gpuq try -- echo" worked, because echo does not lock and kaplumba does. If
# you are tempted to make this script lock anything, do not: the kernel lock in
# the engine is the only thing that cannot be bypassed, and a stray direct run
# from a worktree is exactly the case that silently held 11 GiB for 20 minutes.
#
# USAGE
#   gpuq status          instant. Holder, queue depth, available memory.
#   gpuq try  -- cmd...  run cmd; the engine decides. Exits 75 if the GPU is busy.
#   gpuq run  -- cmd...  same, but sets KAPLUMBA_GPU_LOCK=wait for the engine.
#
# EXIT CODES
#   0  ran cleanly
#   75 EX_TEMPFAIL: the GPU was busy and the engine declined. "Not now" --
#      do other work and retry. Do NOT sleep and retry; that is how an agent
#      ends up in a 20-minute call that looks like a hang.
#   1  usage or runtime error
#
# Fairness is the engine's ticket queue, not this script's concern.

set -uo pipefail

LOCK="${KAPLUMBA_GPU_LOCK_FILE:-$HOME/.kaplumba/gpu.lock}"
QUEUE="${LOCK}.queue"

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

# Available memory in GiB, as top reports it.
#
# Do NOT use vm_stat "Pages free" for this. It counts only pages that have never
# been touched, so it ignores the file cache entirely: on an idle box it read
# 1.47 GiB while top said 14 GiB unused, and a model loaded in 10.8 s. That bug
# made this script warn on a perfectly healthy box, which told agents not to run.
#
# Do not use top's figure without parsing the unit either. top switches between
# K/M/G/T and drops the decimal below 10, so "554M unused" is 0.55 GiB, and
# taking the last comma-separated field yields "unused." rather than a number.
# Both of those were shipped here before being caught.
available_gib() {
  local t
  t="$(top -l 1 -n 0 2>/dev/null | awk '''
        /PhysMem/ {
          n = split($0, a, ",")
          tail = a[n]
          if (match(tail, /[0-9]+(\.[0-9]+)?[KMGT]?/)) {
            tok = substr(tail, RSTART, RLENGTH)
            mul = 1
            if (tok ~ /[Tt]$/) mul = 1099511627776
            else if (tok ~ /[Gg]$/) mul = 1073741824
            else if (tok ~ /[Mm]$/) mul = 1048576
            else if (tok ~ /[Kk]$/) mul = 1024
            gsub(/[KMGT]$/, "", tok)
            printf "%.1f", (tok + 0) * mul / 1073741824
            exit
          }
        }''')"
  case "$t" in
    "" | "." | 0 | 0.0)
      awk '''
        /Pages free:/        { gsub(/\./,"",$NF); s += $NF }
        /Pages inactive:/    { gsub(/\./,"",$NF); s += $NF }
        /Pages speculative:/ { gsub(/\./,"",$NF); s += $NF }
        /Pages purgeable:/   { gsub(/\./,"",$NF); s += $NF }
        END { printf "%.1f", s * 16384 / 1073741824 }
      ''' < <(vm_stat 2>/dev/null) 2>/dev/null || echo "?"
      ;;
    *) echo "$t" ;;
  esac
}

anon_gib() {
  awk '/Pages active:/ { gsub(/\./,"",$NF); printf "%.1f", $NF * 16384 / 1073741824 }' \
    < <(vm_stat 2>/dev/null) 2>/dev/null || echo "?"
}

swap_used_mb() {
  sysctl -n vm.swapusage 2>/dev/null |
    awk -F'[= ]+' '/used/ { printf "%.0f", $2 / 1048576; exit }' || echo "?"
}

# Read the holder out of the lock file. ADVISORY ONLY and possibly stale: the
# kernel lock is the real state. This is a momentary read, never a lock, so it
# can never block behind an 8k benchmark -- which is the entire point of having
# a status command. It can be a second out of date; that is acceptable, because
# the engine re-checks for real.
holder() {
  [ -s "$LOCK" ] || { echo "unknown"; return; }
  local line pid
  line=$(head -1 "$LOCK" 2>/dev/null | tr -d '\n')
  # A crashed or finished engine leaves its last line behind, because this file
  # is advisory and nobody removes it on exit. Reporting a dead pid as the GPU
  # holder then misleads the next reader into thinking the box is busy -- which
  # is exactly what happened: an agent reported "blocked, exit 75" against a pid
  # that had exited twenty seconds earlier. `waiters` already prunes dead pids on
  # read; this does the same, and says plainly that the line is stale instead of
  # printing a pid that is not there.
  pid=$(printf '%s\n' "$line" | sed -n 's/.*(pid \([0-9][0-9]*\)).*/\1/p')
  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
    echo "none (stale lock, pid $pid is gone)"
    return
  fi
  printf '%s\n' "$line"
}

# Live waiters, in arrival order. Dead pids are pruned on read so a crashed
# agent cannot make the queue look busy forever.
waiters() {
  [ -f "$QUEUE" ] || { echo 0; return; }
  awk '{ pid = $1
          if (pid != '"$$"' && system("kill -0 " pid " 2>/dev/null") != 0) next
          print }' "$QUEUE" 2>/dev/null | wc -l | tr -d ' '
}

usage() {
  sed -n '/^# gpuq/,/^set -/p' "$0" | sed 's/^# \{0,1\}//' | sed '/^set -/d'
}

cmd="${1:-status}"
shift 2>/dev/null || true
# Accept `gpuq try -- cmd args` and `gpuq try cmd args` identically.
[ "${1:-}" = "--" ] && shift

case "$cmd" in
  status)
    f="$(available_gib)"
    printf 'gpu: %s\n' "$(holder)"
    printf 'queue: %s waiting\n' "$(waiters)"
    printf 'memory: %s GiB available (reclaimable), %s GiB in use by processes, %s MiB swap\n' \
      "$f" "$(anon_gib)" "$(swap_used_mb)"
    if [ "$f" != "?" ] && awk "BEGIN{exit !($f < 11)}" 2>/dev/null; then
      printf 'warning: only %s GiB available; a model load needs ~12 GiB and will swap\n' "$f"
    else
      printf 'ok: enough available memory for a model load\n'
    fi
    ;;

  try)
    [ $# -eq 0 ] && { echo "usage: gpuq try -- cmd [args...]" >&2; exit 1; }
    # The engine owns the lock. KAPLUMBA_GPU_LOCK=try makes it decline with 75
    # rather than block; without this a second agent waits silently, which is
    # the "looks like a hang" failure this whole script exists to prevent.
    KAPLUMBA_GPU_LOCK=try exec "$@"
    ;;

  run)
    [ $# -eq 0 ] && { echo "usage: gpuq run -- cmd [args...]" >&2; exit 1; }
    KAPLUMBA_GPU_LOCK=wait exec "$@"
    ;;

  -h | --help | help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
