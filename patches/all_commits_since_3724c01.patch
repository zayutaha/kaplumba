+        const uint stride = WORDS;
+        const uint step = SG * 2u;
+        const uint k_unroll_end = (tiles_k / step) * step;
+
+        uint tk = sg * 2u;
+        for (; tk + 3u * step < k_unroll_end; tk += 4u * step) {
+            #pragma unroll
+            for (uint trip = 0u; trip < 4u; ++trip) {
+                const uint t = tk + trip * step;
+                const device uint *t0_0 = col0 + (t + 0u) * stride;
+                const device uint *t1_0 = col0 + (t + 1u) * stride;
+                const device uint *t0_1 = col1 + (t + 0u) * stride;
+                const device uint *t1_1 = col1 + (t + 1u) * stride;
+                const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
+                const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
+                const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
+                const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];
+                float vv[4][8];
+                dequant_4tile_2col(
+                    w0_0_0, w0_0_1, w1_0_0, w1_0_1,
+                    w0_1_0, w0_1_1, w1_1_0, w1_1_1, sh0, rsh0, vv);
+                KAPLUMBA_VERIFY_ROWS4(vv, sh0, rsh0, K, t);
+            }
+        }
+
+        for (; tk < k_unroll_end; tk += step) {
+            const device uint *t0_0 = col0 + (tk + 0u) * stride;
+            const device uint *t1_0 = col0 + (tk + 1u) * stride;
+            const device uint *t0_1 = col1 + (tk + 0u) * stride;
+            const device uint *t1_1 = col1 + (tk + 1u) * stride;
+            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
+            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
+            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
+            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];
+            float vv[4][8];
+            dequant_4tile_2col(
+                w0_0_0, w0_0_1, w1_0_0, w1_0_1,
+                w0_1_0, w0_1_1, w1_1_0, w1_1_1, sh0, rsh0, vv);
+            KAPLUMBA_VERIFY_ROWS4(vv, sh0, rsh0, K, tk);
+        }
+
+        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
+            const device uint *t0_0 = col0 + tk * stride;
+            const device uint *t0_1 = col1 + tk * stride;
+            float v0[8], v1[8];
+            extract_v_mcg_32(t0_0[j0], t0_0[j1], sh0, rsh0, v0);
+            extract_v_mcg_32(t0_1[j0], t0_1[j1], sh0, rsh0, v1);
+            #pragma unroll
+            for (uint m = 0u; m < MR; ++m) {
+                const device half *xr = x + m * K + tk * 16u + r0;
+                const float p0 = float(xr[0]), p1 = float(xr[1]), p2 = float(xr[8]), p3 = float(xr[9]);
+                acc[m][0] = acc[m][0] + dot4_contracted(p0, p1, p2, p3, v0[0], v0[1], v0[2], v0[3]);
+                acc[m][1] = acc[m][1] + dot4_contracted(p0, p1, p2, p3, v0[4], v0[5], v0[6], v0[7]);
+                acc[m][2] = acc[m][2] + dot4_contracted(p0, p1, p2, p3, v1[0], v1[1], v1[2], v1[3]);
+                acc[m][3] = acc[m][3] + dot4_contracted(p0, p1, p2, p3, v1[4], v1[5], v1[6], v1[7]);
+            }
+        }
