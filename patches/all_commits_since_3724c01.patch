+                    out_features: vocab,
+                    rate: self.lm_head.rate,
+                    codebook: self.lm_head.codebook,
+                },
+            )
+        };
+        if let Err(error) = head_encode {
+            encoder.abandon();
+            return Err(ModelError::Kernel(error));
+        }
+        if let Err(error) = self.elements.encode_softcap(
+            &mut encoder,
+            &self.scratch.verify_logits,
+            &self.scratch.verify_capped,
+            tokens * vocab,
+            self.final_softcap,
+        ) {
