+/// Diagnostic: `KAPLUMBA_SMALLM_SKIP="in x out"` exempts one shape.
+fn smallm_skipped(in_features: usize, out_features: usize) -> bool {
+    static SKIP: std::sync::OnceLock<Option<(usize, usize)>> = std::sync::OnceLock::new();
+    let skip = SKIP.get_or_init(|| {
+        let raw = std::env::var("KAPLUMBA_SMALLM_SKIP").ok()?;
+        let (a, b) = raw.split_once('x')?;
+        Some((a.trim().parse().ok()?, b.trim().parse().ok()?))
+    });
+    *skip == Some((in_features, out_features))
+}
