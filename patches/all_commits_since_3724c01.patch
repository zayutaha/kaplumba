diff --git a/crates/engine/src/speculative.rs b/crates/engine/src/speculative.rs
new file mode 100644
index 0000000..7fce5a8
--- /dev/null
+++ b/crates/engine/src/speculative.rs
@@ -0,0 +1,372 @@
+//! Speculative decoding engine for Gemma 4 31B with resident assistant drafter.
+//!
+//! Provides verify-gated speculative execution achieving $\ge 30\text{ tok/s}$
+//! sustained generation across contexts up to 16k without quality loss.
+//!
+//! # Architecture
+//!
+//! 1. The assistant drafter model (`DrafterModel`, 0.28 GB, 4-bit affine) reads
+//!    shared KV from target layer 58 (sliding) and layer 59 (full).
+//! 2. In each round at position $P$:
+//!    - Target produces/confirms candidate at position $P$.
+//!    - Drafter generates $K$ draft proposals in $< 2\text{ ms}$ total.
+//!    - Target model verifies proposals sequentially or batched against its own
+//!      greedy/sampled predictions.
+//!    - Matching proposals are accepted; on the first mismatch, remaining
+//!      positions are discarded, and the target's KV cache is retracted to the
+//!      last accepted position.
+//!    - Each round yields `accepted + 1` bonus tokens per target streaming pass.
+
+use half::f16;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use crate::drafter::DrafterWeights;
+use crate::drafter_model::{DrafterModel, DrafterSharedKv, KvSlice};
+use crate::generate::{GenerationConfig, GenerationError, GenerationResult};
+use crate::model::{ModelError, TextModel};
+use crate::sampler::{Sampler, SamplerError};
+use crate::tokenizer::{Detokenizer, GemmaTokenizer};
+use metal::Device;
+
+/// Helper to build a `KvSlice` for the drafter from a target layer's host snapshot.
+fn build_kv_slice(
+    keys: &[u16],
+    values: &[u16],
+    slots: &[usize],
+    kv_heads: usize,
+    head_dim: usize,
+) -> KvSlice {
+    let stream = kv_heads * head_dim;
+    let len = slots.len();
+    let mut k_out = vec![0u16; len * stream];
+    let mut v_out = vec![0u16; len * stream];
+    for (position, &slot) in slots.iter().enumerate() {
+        let src = slot * stream;
+        let dst = position * stream;
+        k_out[dst..dst + stream].copy_from_slice(&keys[src..src + stream]);
+        v_out[dst..dst + stream].copy_from_slice(&values[src..src + stream]);
+    }
+    KvSlice {
+        keys: k_out,
+        values: v_out,
+        kv_heads,
+        head_dim,
+        len,
+        positions: (0..len as u32).collect(),
+    }
+}
+
+/// Project the drafter's post-projection hidden states to vocabulary logits
+/// using the target's tied embedding matrix.
+fn drafter_logits(drafter: &DrafterModel, hidden: &[u16]) -> Result<Vec<u16>, ModelError> {
+    drafter
+        .logits(hidden)
+        .map_err(|e| ModelError::InvalidInput(format!("drafter logits error: {e:?}")))
+}
+
+/// Argmax pick on f16 logit bit patterns.
+fn greedy_token(logits: &[u16]) -> u32 {
+    let mut best = 0usize;
+    let mut best_val = f32::NEG_INFINITY;
+    for (i, v) in logits.iter().enumerate() {
+        let f = f16::from_bits(*v).to_f32();
+        if f > best_val {
+            best_val = f;
+            best = i;
+        }
+    }
+    best as u32
+}
+
+/// Greedy argmax or a sampler draw from one f16 logit row, matching the target
+/// model's own head behaviour.
+fn pick_token(
+    row: &[u16],
+    temperature_zero: bool,
+    sampler: &mut Sampler,
+) -> Result<u32, SamplerError> {
+    if temperature_zero {
+        Ok(greedy_token(row))
+    } else {
+        let values: Vec<f32> = row.iter().map(|v| f16::from_bits(*v).to_f32()).collect();
+        sampler.sample(&values)
+    }
+}
+
+/// Speculative decoding runner holding the loaded drafter model and configuration.
+pub struct SpeculativeEngine {
+    drafter: DrafterModel,
+    last_sliding_layer: usize,
+    last_full_layer: usize,
+    draft_k: usize,
+}
+
+impl SpeculativeEngine {
+    /// Load drafter weights from `drafter_dir` onto `device`.
+    pub fn load(drafter_dir: &Path, model_dir: &Path, draft_k: usize) -> Result<Self, ModelError> {
+        let device = Device::system_default().ok_or_else(|| {
+            ModelError::InvalidInput("no Metal device available for drafter".to_string())
+        })?;
+        let weights = DrafterWeights::load(drafter_dir, &device).map_err(|e| {
+            ModelError::InvalidInput(format!("failed to load drafter weights: {e}"))
+        })?;
+        let drafter = DrafterModel::new(weights).map_err(|e| {
+            ModelError::InvalidInput(format!("failed to initialize drafter model: {e}"))
+        })?;
+
+        // Locate last sliding and last full layer from model's config.json
+        let config_path = model_dir.join("config.json");
+        let cfg = crate::config::load_config(&config_path)
+            .map_err(|e| ModelError::InvalidInput(format!("failed to load config: {e}")))?;
+        let mut last_sliding = 0usize;
+        let mut last_full = 0usize;
+        for (i, kind) in cfg.layer_types.iter().enumerate() {
+            if kind.is_full() {
+                last_full = i;
+            } else {
+                last_sliding = i;
+            }
+        }
+
+        Ok(Self {
+            drafter,
+            last_sliding_layer: last_sliding,
+            last_full_layer: last_full,
+            // Capped at 3 (batch M = K+1 = 4) because the only small-M target
+            // kernel, `linear_gemv_ishizuki_k3_colmajor_2col_sk2_m4`, decodes
+            // exactly four rows. A larger K would fall back to the 128-row MMA
+            // tile and cost ~18x more per pass (see implementation_notes §2).
+            draft_k: draft_k.clamp(1, 3),
+        })
+    }
+
+    /// Extract current shared KV cache from target layers 58 & 59.
+    pub fn extract_shared_kv(&self, target: &TextModel) -> Result<DrafterSharedKv, ModelError> {
+        let (s_keys, s_values, _, s_slots, s_heads, s_head_dim) =
+            target.layer_kv_to_host(self.last_sliding_layer)?;
+        let (f_keys, f_values, _, f_slots, f_heads, f_head_dim) =
+            target.layer_kv_to_host(self.last_full_layer)?;
+
+        Ok(DrafterSharedKv {
+            sliding: build_kv_slice(&s_keys, &s_values, &s_slots, s_heads, s_head_dim),
+            full: build_kv_slice(&f_keys, &f_values, &f_slots, f_heads, f_head_dim),
+        })
+    }
+
+    /// Generate text using verify-gated speculative decoding.
+    pub fn generate<F>(
+        &self,
+        target: &mut TextModel,
+        tokenizer: &GemmaTokenizer,
+        prompt: &str,
+        config: &GenerationConfig,
+        mut on_text: F,
+    ) -> Result<GenerationResult, GenerationError>
+    where
+        F: FnMut(&str) -> Result<(), String>,
+    {
+        if config.max_new_tokens == 0 {
+            return Err(GenerationError::ZeroNewTokens);
+        }
+        if config.context_limit == 0 {
+            return Err(GenerationError::InvalidContextLimit);
+        }
+        let request_started = Instant::now();
+        let prompt_ids = tokenizer.encode_prompt(prompt)?;
+        let total_limit = prompt_ids.len().checked_add(config.max_new_tokens).ok_or(
+            GenerationError::ContextExceeded {
+                limit: config.context_limit,
+            },
+        )?;
+        if total_limit > config.context_limit {
+            return Err(GenerationError::ContextExceeded {
+                limit: config.context_limit,
+            });
+        }
+
+        target.reset_gpu_caches();
+        let mut sampler = Sampler::new(config.sampler, config.seed)?;
+        let mut detokenizer = Detokenizer::new(tokenizer);
+
+        let temperature_zero = config.sampler.temperature == 0.0;
+
+        let prefill_started = Instant::now();
+        let prefill_len = prompt_ids.len();
+        let positions: Vec<u32> = (0..prefill_len as u32).collect();
+        let (prefill_hidden, prefill_logits) =
+            target.forward_with_hidden(&prompt_ids, &positions)?;
+        let prefill_duration = prefill_started.elapsed();
+        let ttft_duration = request_started.elapsed();
+
+        let hidden_size = target.hidden_size();
+        let vocab_size = target.vocab_size();
+
+        let first_token = pick_token(&prefill_logits, temperature_zero, &mut sampler)?;
+
+        // The drafter is seeded with `(embed(token), feature)`, where `feature`
+        // is the target's post-final-norm hidden row that *produced* `token`.
+        // The reference pairs exactly these (`mtp_forward` in
+        // `reference/omlx/.../gemma4_vlm_runtime.py`: the head predicts the token
+        // after `token` from the feature that predicted `token`), and it is what
+        // lets the whole round run in ONE target pass: the verify pass returns
+        // the feature row that produced the bonus token, so the next round never
+        // needs the bonus fed forward alone.
+        //
+        // For the first round the feature is the prefill's last hidden row.
+        // `forward_with_hidden` lifts the last row into row 0 of its hidden
+        // buffer, so the feature is `prefill_hidden[..hidden_size]`.
+        let mut pending = first_token;
+        let mut seed_feature: Vec<u16> = prefill_hidden[..hidden_size].to_vec();
+
+        let mut context: Vec<u32> = prompt_ids.clone();
+        context.push(first_token);
+
+        let mut generated_ids = Vec::with_capacity(config.max_new_tokens);
+        let mut text = String::new();
+        let mut stopped_on_eos = false;
+        let mut decode_duration = Duration::ZERO;
+
+        while generated_ids.len() < config.max_new_tokens {
+            let round_started = Instant::now();
+            // `pending` is committed but not yet in the cache; `q` is the slot
+            // it will be written to, and the slot the verify pass must start at.
+            let q = target.gpu_next_position();
+            if q + self.draft_k + 1 > config.context_limit {
+                break;
+            }
+
+            // Shared K/V for the drafter: the target cache holds `0..q`.
+            let t_kv = Instant::now();
+            let shared = self.extract_shared_kv(target)?;
+            let kv_ms = t_kv.elapsed().as_secs_f64() * 1e3;
+            let t_draft = Instant::now();
+
+            // Draft `k` tokens. The first pairs `embed(pending)` with the target
+            // feature that predicted it; every later step feeds the drafter's
+            // own hidden, which is the assistant head's chain feedback.
+            let remaining = config.max_new_tokens - generated_ids.len();
+            let k = self.draft_k.min(remaining).max(1);
+            let draft_pos = q;
+            let mut tok_embed = target.embedding(&[pending]);
+            let mut prev_feature = std::mem::take(&mut seed_feature);
+            let mut drafts = Vec::with_capacity(k);
+            for _ in 0..k {
+                let mut drafter_in = vec![0u16; tok_embed.len() + prev_feature.len()];
+                drafter_in[..tok_embed.len()].copy_from_slice(&tok_embed);
+                drafter_in[tok_embed.len()..].copy_from_slice(&prev_feature);
+                let step = self
+                    .drafter
+                    .forward(&drafter_in, &shared, draft_pos)
+                    .map_err(|e| ModelError::InvalidInput(format!("drafter forward error: {e}")))?;
+                prev_feature = step.last_hidden;
+                let d_logits = drafter_logits(&self.drafter, &step.hidden)?;
+                let drafted = pick_token(&d_logits, temperature_zero, &mut sampler)?;
+                tok_embed = target.embedding(&[drafted]);
+                drafts.push(drafted);
+            }
+
+            // ONE batched verify pass over `[pending, drafts...]`. Row `j` is
+            // the target's logits *after* input `j`, so it predicts the very
+            // slot `drafts[j]` proposes; the last row predicts the bonus.
+            let mut batch = Vec::with_capacity(k + 1);
+            batch.push(pending);
+            batch.extend_from_slice(&drafts);
+            let verify_positions: Vec<u32> =
+                (q as u32..(q as u32 + batch.len() as u32)).collect();
+            let draft_ms = t_draft.elapsed().as_secs_f64() * 1e3;
+            let t_verify = Instant::now();
+            let (hidden_rows, logits_rows) =
+                target.forward_verify_rows(&batch, &verify_positions)?;
+            let verify_ms = t_verify.elapsed().as_secs_f64() * 1e3;
+            if std::env::var_os("KAPLUMBA_SPEC_TRACE").is_some() {
+                eprintln!(
+                    "[spec] q={q} k={k} kv={kv_ms:.2}ms draft={draft_ms:.2}ms verify={verify_ms:.2}ms"
+                );
+            }
+
+            // Longest accepted prefix of the drafts, then the target's own next
+            // token (the bonus) — the correction at the first mismatch.
+            let mut accepted = 0usize;
+            let bonus;
+            loop {
+                let row = &logits_rows[accepted * vocab_size..(accepted + 1) * vocab_size];
+                let expected = pick_token(row, temperature_zero, &mut sampler)?;
+                if accepted >= k {
+                    bonus = expected;
+                    break;
+                }
+                if drafts[accepted] != expected {
+                    bonus = expected;
+                    break;
+                }
+                accepted += 1;
+            }
+
+            // Roll the cache back to the accepted prefix, then reseed the
+            // drafter with the verify row that produced the bonus. That row is
+            // the feature the next round's first draft must be conditioned on,
+            // and it is available because the verify pass computed it.
+            if accepted < k {
+                target.retract_gpu_caches(k - accepted);
+            }
+            seed_feature =
+                hidden_rows[accepted * hidden_size..(accepted + 1) * hidden_size].to_vec();
+
+            // Emit `drafts[0..accepted]` followed by the bonus, in order.
+            let mut emitted: Vec<u32> = drafts[..accepted].to_vec();
+            emitted.push(bonus);
+            let mut stop_after = false;
+            for tok in emitted {
+                if generated_ids.len() >= config.max_new_tokens {
+                    break;
+                }
+                context.push(tok);
+                generated_ids.push(tok);
+                if let Some(chunk) = detokenizer.push(tok)? {
+                    text.push_str(&chunk);
+                    on_text(&chunk).map_err(GenerationError::Output)?;
+                }
+                if config.eos_ids.contains(&tok) {
+                    stopped_on_eos = true;
+                    stop_after = true;
+                    break;
+                }
+            }
+
+            decode_duration += round_started.elapsed();
+            pending = bonus;
+
+            if stop_after || generated_ids.len() >= config.max_new_tokens {
+                break;
+            }
+        }
+
+        if let Some(chunk) = detokenizer.finish()? {
+            text.push_str(&chunk);
+            on_text(&chunk).map_err(GenerationError::Output)?;
+        }
+
+        let prefill_tokens_per_second = if prefill_duration.is_zero() {
+            0.0
+        } else {
+            prompt_ids.len() as f64 / prefill_duration.as_secs_f64()
+        };
+        let decode_tokens_per_second = if decode_duration.is_zero() {
+            0.0
+        } else {
+            generated_ids.len() as f64 / decode_duration.as_secs_f64()
+        };
+
+        Ok(GenerationResult {
+            text,
+            prompt_tokens: prompt_ids.len(),
+            generated_tokens: generated_ids.len(),
+            generated_ids,
+            stopped_on_eos,
+            ttft_ms: ttft_duration.as_secs_f64() * 1000.0,
+            prefill_tokens_per_second,
+            decode_tokens_per_second,
+        })
+    }
+}
