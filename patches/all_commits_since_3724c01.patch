+
+// Row-major four-row verify GEMV -- the variant this checkpoint actually needs.
+//
+// `linear_gemv_ishizuki_k3_colmajor_2col_sk2_m4` decodes the column-major ring and
+// is unusable here: this checkpoint's 411 tensors are row-major (`perm=0` from
+// `KAPLUMBA_SMALLM_LOG`, and `KAPLUMBA_TRACE_GEMV` shows the M=1 decode kernel is
+// `linear_gemv_ishizuki_k3_w2`). Pointing a column-major kernel at row-major
+// weights does not fault -- it decodes the wrong numbers and the model emits
+// noise. This kernel is `linear_gemv_ishizuki_k3` (linear.metal:1822) with the
+// tile loop's arithmetic repeated for four query rows.
+//
+// The structure is copied from that kernel and has to stay that way, because the
+// k-tile *partition* is part of the arithmetic, not an implementation detail: each
+// simdgroup `sg` takes k-tiles `sg, sg+8, sg+16, ...`, each accumulates in its own
+// registers, the partials reduce with `simd_shuffle_xor 1,2`, and the final sum
+// walks `red[g]` for `g = 0..7`. Split k differently and every output moves. So the
+// split, the reduction and the summation order are preserved verbatim; the row loop
+// is the only addition.
+//
+// The accumulation is spelled exactly as `linear_gemv_ishizuki_k3` spells it --
+// `acc += a0*v0 + a1*v1 + a2*v2 + a3*v3` -- and that is load-bearing in the
+// opposite direction from the column-major twin. Metal's fast math picks the same
+// association it picks for the M=1 kernel, so this kernel is **bit-identical** to
+// it: measured 0 ulp on every row of five shapes, with fast math on. Wrapping
+// these in `dot4_contracted`'s pinned `fma` chain -- which `_2col` must do, because
+// its body shares one `p0..p3` across four accumulators and its rows otherwise
+// disagree with each other -- makes this kernel 1e-6 off instead of exact, and
+// buys nothing: this kernel has no such structure. `smallm_gemv_bit_exact`
+// asserts the exactness (`Layout::is_bit_exact`), so it is checked rather than
+// claimed, and a sabotage on one activation (x 1.0000001f) fails it on all five
+// shapes while the 1e-4 budget stays green.
+kernel void linear_gemv_ishizuki_k3_rm_m4(
+    const device ushort *packed [[buffer(0)]],
+    const device half *x [[buffer(1)]],
+    device float *y [[buffer(2)]],
+    constant const uint *shape [[buffer(3)]],
+    uint lid [[thread_position_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]],
+    uint tgid [[threadgroup_position_in_grid]],
+    uint ntg [[threadgroups_per_grid]]) {
+    constexpr uint KA = 3u;
+    constexpr int CB = 1;
+    constexpr uint RING = 256u * KA;
+    constexpr uint WORDS = RING / 32u;
+    constexpr uint MR = 4u;
+    constexpr int SG = 8;
+    const uint K = shape[0];
+    const uint N = shape[1];
+    const uint tiles_n = N / 16u;
+    const uint tiles_k = K / 16u;
+    threadgroup float red[MR][SG][16];
+    const uint r0 = (lane % 4u) * 2u;
+
+    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
+        float acc[MR][2];
+        #pragma unroll
+        for (uint m = 0u; m < MR; ++m) {
+            acc[m][0] = 0.0f;
+            acc[m][1] = 0.0f;
+        }
+        // j0/j1/j2 and sh depend only on the lane, so they hoist out of the tile
+        // loop -- same as the M=1 kernel.
+        const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
+        const uint sh0 = lo0 % 32u;
+        const uint hi0 = lo0 / 32u;
+        const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
+        const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;
+        const uint j2 = j1 + 1u >= WORDS ? j1 + 1u - WORDS : j1 + 1u;
+        const device uint *column = (const device uint *)packed + tn * WORDS;
+        const uint stride = tiles_n * WORDS;
+
+        uint tk = sg;
+        for (; tk + SG < tiles_k; tk += 2u * SG) {
+            const device uint *t0 = column + (tk + 0 * SG) * stride;
+            const ulong w0a = t0[j0], w0b = t0[j1], w0c = t0[j2];
+            const ulong A0 = ((w0a << 32) | w0b) << sh0 | (sh0 ? (w0c >> (32 - sh0)) : 0ul);
+            const ulong B0 = ((w0b << 32) | w0c) << sh0;
+            float v0[8];
+            #pragma unroll
+            for (uint i = 0; i < 8u; ++i) {
+                const uint r = i * KA + 16u;
+                const uint s = (r <= 64u) ? uint(A0 >> (64u - r)) : uint(B0 >> (96u - r));
+                v0[i] = decode_state(s & 0xffffu, CB);
+            }
+            const device uint *t1 = column + (tk + 1 * SG) * stride;
+            const ulong w1a = t1[j0], w1b = t1[j1], w1c = t1[j2];
+            const ulong A1 = ((w1a << 32) | w1b) << sh0 | (sh0 ? (w1c >> (32 - sh0)) : 0ul);
+            const ulong B1 = ((w1b << 32) | w1c) << sh0;
+            float v1[8];
+            #pragma unroll
+            for (uint i = 0; i < 8u; ++i) {
+                const uint r = i * KA + 16u;
+                const uint s = (r <= 64u) ? uint(A1 >> (64u - r)) : uint(B1 >> (96u - r));
+                v1[i] = decode_state(s & 0xffffu, CB);
+            }
+            #pragma unroll
+            for (uint m = 0u; m < MR; ++m) {
+                const device half *a = x + m * K + (tk + 0 * SG) * 16u + r0;
+                const float a0 = float(a[0]), a1 = float(a[1]);
+                const float a2 = float(a[8]), a3 = float(a[9]);
+                acc[m][0] += a0 * v0[0] + a1 * v0[1] + a2 * v0[2] + a3 * v0[3];
+                acc[m][1] += a0 * v0[4] + a1 * v0[5] + a2 * v0[6] + a3 * v0[7];
+                const device half *b = x + m * K + (tk + 1 * SG) * 16u + r0;
+                const float b0 = float(b[0]), b1 = float(b[1]);
+                const float b2 = float(b[8]), b3 = float(b[9]);
+                acc[m][0] += b0 * v1[0] + b1 * v1[1] + b2 * v1[2] + b3 * v1[3];
+                acc[m][1] += b0 * v1[4] + b1 * v1[5] + b2 * v1[6] + b3 * v1[7];
+            }
+        }
+
+        for (; tk < tiles_k; tk += SG) {
+            const device uint *t0 = column + tk * stride;
+            const ulong a0 = t0[j0], a1 = t0[j1], a2 = t0[j2];
+            const ulong A0 = ((a0 << 32) | a1) << sh0 | (sh0 ? (a2 >> (32 - sh0)) : 0ul);
+            const ulong B0 = ((a1 << 32) | a2) << sh0;
+            float v[8];
+            #pragma unroll
+            for (uint i = 0; i < 8u; ++i) {
+                const uint r = i * KA + 16u;
+                const uint s = (r <= 64u) ? uint(A0 >> (64u - r)) : uint(B0 >> (96u - r));
+                v[i] = decode_state(s & 0xffffu, CB);
+            }
+            #pragma unroll
+            for (uint m = 0u; m < MR; ++m) {
+                const device half *a = x + m * K + tk * 16u + r0;
+                const float a0 = float(a[0]), a1 = float(a[1]);
+                const float a2 = float(a[8]), a3 = float(a[9]);
+                acc[m][0] += a0 * v[0] + a1 * v[1] + a2 * v[2] + a3 * v[3];
+                acc[m][1] += a0 * v[4] + a1 * v[5] + a2 * v[6] + a3 * v[7];
+            }
+        }
+
+        #pragma unroll
+        for (uint m = 0u; m < MR; ++m) {
+            acc[m][0] += simd_shuffle_xor(acc[m][0], 1u);
+            acc[m][0] += simd_shuffle_xor(acc[m][0], 2u);
+            acc[m][1] += simd_shuffle_xor(acc[m][1], 1u);
+            acc[m][1] += simd_shuffle_xor(acc[m][1], 2u);
+        }
+        #pragma unroll
+        for (uint m = 0u; m < MR; ++m) {
+            if (lane % 4u == 0u) {
+                red[m][sg][lane / 4u] = acc[m][0];
+                red[m][sg][lane / 4u + 8u] = acc[m][1];
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (lid < 16u * MR) {
+            const uint m = lid / 16u;
+            const uint c = lid % 16u;
+            float sum = 0.0f;
+            for (int g = 0; g < SG; ++g) {
+                sum += red[m][g][c];
+            }
+            y[m * N + tn * 16u + c] = sum;
+        }
+        // `red` is reused by the next output tile, so it must be drained first.
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+}
