+            let src = self.scratch.normed.contents() as *const u16;
+            std::ptr::copy_nonoverlapping(src, hidden_rows.as_mut_ptr(), hidden_rows.len());
+        }
+        let mut logits_rows = vec![0u16; tokens * vocab];
+        unsafe {
+            let src = self.scratch.verify_capped.contents() as *const u16;
+            std::ptr::copy_nonoverlapping(src, logits_rows.as_mut_ptr(), logits_rows.len());
+        }
+        Ok((hidden_rows, logits_rows))
+    }
