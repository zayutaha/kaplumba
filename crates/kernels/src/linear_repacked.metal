// Repacked (column-major) EXL3 GEMV kernels.
//
// WHY THIS IS A SEPARATE FILE
//
// `linear.metal` is partly generated: it opens with
//   // GENERATED by scripts/gen_exl3_gemv.py -- do not hand-edit below this line.
// and the generator rewrites everything from the first `linear_gemv_exl3_k1(` up to
// `kernel void linear_gemv(` -- about 8200 lines. These kernels sat at
// linear.metal:7968-9475, inside that window.
//
// This is not theoretical. Running the generator during the previous task deleted
// all of them, live, in the working tree, and `ishizuki_gemv_pipeline`
// (linear.rs) then stopped finding `linear_gemv_ishizuki_k3_colmajor` and
// **silently fell through to the row-major kernel on column-major weights** --
// the gibberish recorded in implementation_notes.md, reintroduced by a build
// step rather than a code change. `LinearKernels::new` concatenates this file
// onto `linear.metal` so the kernels keep sharing one `decode_state` and one
// compilation.
//
// The only symbol needed from `linear.metal` is `decode_state`
// (linear.metal:138), which is in the generator's *preserved* preamble.
//
// VERIFIED BY spec acceptance criterion AC6: run the generator, then
// `git diff --exit-code` must be clean.
//
// BIT-EXACTNESS -- read before trusting any of these.
//
// `linear_gemv_ishizuki_k3_colmajor_contig4` is the kernel the engine actually
// dispatches (`KAPLUMBA_TRACE_GEMV=1`). It is NOT bit-identical to `_colmajor`
// in f32: it starts each simdgroup at `tk = sg * 4u` and sums four *contiguous*
// tiles, where `_colmajor` starts at `tk = sg` and sums tiles at
// `tk + {0,SG,2SG,3SG}`. Same tiles, ascending order, different accumulators --
// a reassociation of the same float sum, and measured at up to 51 ULP in f32.
//
// It IS bit-identical after the fp16 rounding in `linear_finalize_simd`, which is
// what the sampler reads: 0 of 21504 outputs differ. That is the property that
// matters, and it is asserted -- see `crates/engine/tests/live_kernel_bit_exact.rs`,
// which asserts fp16 equality (not an f32 tolerance) against the reference.
//
// `linear_gemv_ishizuki_k3_colmajor_sk4` / `contig4_sk2` / `contig4_sk4` split K
// across threadgroups and reduce in a second pass. Same story: they reassociate,
// they are not bit-identical in f32, and they are not on the engine's decode path
// (`ishizuki_gemv_pipeline` selects `_contig4` or `_colmajor`). Do not wire them
// into decode without extending that test to them first.
//
// REMOVED HERE (unreachable, compiled on every `LinearKernels::new`):
//   linear_gemv_repacked_k3              the reverted `simd_shuffle`
//                                        cooperative-load experiment
//                                        (180.5 -> 146.5 GB/s). The negative
//                                        result stays in the notes.
//   linear_gemv_ishizuki_k3_colmajor_pair  no Rust caller.

static inline void extract_v_mcg_32(uint wa, uint wb, uint sh0, uint rsh0, thread float v[8]) {
    const uint A_hi = (wa << sh0) | (wb >> rsh0), A_lo = wb << sh0;
    uint4 c0 = uint4((A_hi >> 16) & 0xffffu, (A_hi >> 13) & 0xffffu, (A_hi >> 10) & 0xffffu, (A_hi >> 7) & 0xffffu);
    c0 = 0x3b603b60u ^ ((c0 * 0xCBAC1FEDu) & 0x8fff8fffu);
    half2 h0 = as_type<half2>(c0.x), h1 = as_type<half2>(c0.y), h2 = as_type<half2>(c0.z), h3 = as_type<half2>(c0.w);
    v[0] = float(h0.x + h0.y); v[1] = float(h1.x + h1.y); v[2] = float(h2.x + h2.y); v[3] = float(h3.x + h3.y);
    uint4 c1 = uint4((A_hi >> 4) & 0xffffu, (A_hi >> 1) & 0xffffu, ((A_hi << 2) | (A_lo >> 30)) & 0xffffu, ((A_hi << 5) | (A_lo >> 27)) & 0xffffu);
    c1 = 0x3b603b60u ^ ((c1 * 0xCBAC1FEDu) & 0x8fff8fffu);
    half2 h4 = as_type<half2>(c1.x), h5 = as_type<half2>(c1.y), h6 = as_type<half2>(c1.z), h7 = as_type<half2>(c1.w);
    v[4] = float(h4.x + h4.y); v[5] = float(h5.x + h5.y); v[6] = float(h6.x + h6.y); v[7] = float(h7.x + h7.y);
}

static inline void decode_and_accum_4tile_2col(
    uint w0_0_0, uint w0_0_1,
    uint w1_0_0, uint w1_0_1,
    uint w0_1_0, uint w0_1_1,
    uint w1_1_0, uint w1_1_1,
    uint sh0, uint rsh0,
    float p00, float p01, float p02, float p03,
    float p10, float p11, float p12, float p13,
    thread float &acc0_0, thread float &acc0_1,
    thread float &acc1_0, thread float &acc1_1
) {
    const uint A0_hi = (w0_0_0 << sh0) | (w0_0_1 >> rsh0), A0_lo = w0_0_1 << sh0;
    const uint A1_hi = (w1_0_0 << sh0) | (w1_0_1 >> rsh0), A1_lo = w1_0_1 << sh0;
    const uint A2_hi = (w0_1_0 << sh0) | (w0_1_1 >> rsh0), A2_lo = w0_1_1 << sh0;
    const uint A3_hi = (w1_1_0 << sh0) | (w1_1_1 >> rsh0), A3_lo = w1_1_1 << sh0;

    uint4 c0_0 = uint4((A0_hi >> 16) & 0xffffu, (A0_hi >> 13) & 0xffffu, (A0_hi >> 10) & 0xffffu, (A0_hi >> 7) & 0xffffu);
    uint4 c0_1 = uint4((A1_hi >> 16) & 0xffffu, (A1_hi >> 13) & 0xffffu, (A1_hi >> 10) & 0xffffu, (A1_hi >> 7) & 0xffffu);
    uint4 c0_2 = uint4((A2_hi >> 16) & 0xffffu, (A2_hi >> 13) & 0xffffu, (A2_hi >> 10) & 0xffffu, (A2_hi >> 7) & 0xffffu);
    uint4 c0_3 = uint4((A3_hi >> 16) & 0xffffu, (A3_hi >> 13) & 0xffffu, (A3_hi >> 10) & 0xffffu, (A3_hi >> 7) & 0xffffu);

    c0_0 = 0x3b603b60u ^ ((c0_0 * 0xCBAC1FEDu) & 0x8fff8fffu);
    c0_1 = 0x3b603b60u ^ ((c0_1 * 0xCBAC1FEDu) & 0x8fff8fffu);
    c0_2 = 0x3b603b60u ^ ((c0_2 * 0xCBAC1FEDu) & 0x8fff8fffu);
    c0_3 = 0x3b603b60u ^ ((c0_3 * 0xCBAC1FEDu) & 0x8fff8fffu);

    half2 h0_0 = as_type<half2>(c0_0.x), h0_1 = as_type<half2>(c0_0.y), h0_2 = as_type<half2>(c0_0.z), h0_3 = as_type<half2>(c0_0.w);
    float v0_0 = float(h0_0.x + h0_0.y), v0_1 = float(h0_1.x + h0_1.y), v0_2 = float(h0_2.x + h0_2.y), v0_3 = float(h0_3.x + h0_3.y);

    half2 h1_0 = as_type<half2>(c0_1.x), h1_1 = as_type<half2>(c0_1.y), h1_2 = as_type<half2>(c0_1.z), h1_3 = as_type<half2>(c0_1.w);
    float v1_0 = float(h1_0.x + h1_0.y), v1_1 = float(h1_1.x + h1_1.y), v1_2 = float(h1_2.x + h1_2.y), v1_3 = float(h1_3.x + h1_3.y);

    half2 h2_0 = as_type<half2>(c0_2.x), h2_1 = as_type<half2>(c0_2.y), h2_2 = as_type<half2>(c0_2.z), h2_3 = as_type<half2>(c0_2.w);
    float v2_0 = float(h2_0.x + h2_0.y), v2_1 = float(h2_1.x + h2_1.y), v2_2 = float(h2_2.x + h2_2.y), v2_3 = float(h2_3.x + h2_3.y);

    half2 h3_0 = as_type<half2>(c0_3.x), h3_1 = as_type<half2>(c0_3.y), h3_2 = as_type<half2>(c0_3.z), h3_3 = as_type<half2>(c0_3.w);
    float v3_0 = float(h3_0.x + h3_0.y), v3_1 = float(h3_1.x + h3_1.y), v3_2 = float(h3_2.x + h3_2.y), v3_3 = float(h3_3.x + h3_3.y);

    uint4 c1_0 = uint4((A0_hi >> 4) & 0xffffu, (A0_hi >> 1) & 0xffffu, ((A0_hi << 2) | (A0_lo >> 30)) & 0xffffu, ((A0_hi << 5) | (A0_lo >> 27)) & 0xffffu);
    uint4 c1_1 = uint4((A1_hi >> 4) & 0xffffu, (A1_hi >> 1) & 0xffffu, ((A1_hi << 2) | (A1_lo >> 30)) & 0xffffu, ((A1_hi << 5) | (A1_lo >> 27)) & 0xffffu);
    uint4 c1_2 = uint4((A2_hi >> 4) & 0xffffu, (A2_hi >> 1) & 0xffffu, ((A2_hi << 2) | (A2_lo >> 30)) & 0xffffu, ((A2_hi << 5) | (A2_lo >> 27)) & 0xffffu);
    uint4 c1_3 = uint4((A3_hi >> 4) & 0xffffu, (A3_hi >> 1) & 0xffffu, ((A3_hi << 2) | (A3_lo >> 30)) & 0xffffu, ((A3_hi << 5) | (A3_lo >> 27)) & 0xffffu);

    c1_0 = 0x3b603b60u ^ ((c1_0 * 0xCBAC1FEDu) & 0x8fff8fffu);
    c1_1 = 0x3b603b60u ^ ((c1_1 * 0xCBAC1FEDu) & 0x8fff8fffu);
    c1_2 = 0x3b603b60u ^ ((c1_2 * 0xCBAC1FEDu) & 0x8fff8fffu);
    c1_3 = 0x3b603b60u ^ ((c1_3 * 0xCBAC1FEDu) & 0x8fff8fffu);

    half2 h0_4 = as_type<half2>(c1_0.x), h0_5 = as_type<half2>(c1_0.y), h0_6 = as_type<half2>(c1_0.z), h0_7 = as_type<half2>(c1_0.w);
    float v0_4 = float(h0_4.x + h0_4.y), v0_5 = float(h0_5.x + h0_5.y), v0_6 = float(h0_6.x + h0_6.y), v0_7 = float(h0_7.x + h0_7.y);

    half2 h1_4 = as_type<half2>(c1_1.x), h1_5 = as_type<half2>(c1_1.y), h1_6 = as_type<half2>(c1_1.z), h1_7 = as_type<half2>(c1_1.w);
    float v1_4 = float(h1_4.x + h1_4.y), v1_5 = float(h1_5.x + h1_5.y), v1_6 = float(h1_6.x + h1_6.y), v1_7 = float(h1_7.x + h1_7.y);

    half2 h2_4 = as_type<half2>(c1_2.x), h2_5 = as_type<half2>(c1_2.y), h2_6 = as_type<half2>(c1_2.z), h2_7 = as_type<half2>(c1_2.w);
    float v2_4 = float(h2_4.x + h2_4.y), v2_5 = float(h2_5.x + h2_5.y), v2_6 = float(h2_6.x + h2_6.y), v2_7 = float(h2_7.x + h2_7.y);

    half2 h3_4 = as_type<half2>(c1_3.x), h3_5 = as_type<half2>(c1_3.y), h3_6 = as_type<half2>(c1_3.z), h3_7 = as_type<half2>(c1_3.w);
    float v3_4 = float(h3_4.x + h3_4.y), v3_5 = float(h3_5.x + h3_5.y), v3_6 = float(h3_6.x + h3_6.y), v3_7 = float(h3_7.x + h3_7.y);

    acc0_0 += p00 * v0_0 + p01 * v0_1 + p02 * v0_2 + p03 * v0_3;
    acc0_1 += p00 * v0_4 + p01 * v0_5 + p02 * v0_6 + p03 * v0_7;

    acc0_0 += p10 * v1_0 + p11 * v1_1 + p12 * v1_2 + p13 * v1_3;
    acc0_1 += p10 * v1_4 + p11 * v1_5 + p12 * v1_6 + p13 * v1_7;

    acc1_0 += p00 * v2_0 + p01 * v2_1 + p02 * v2_2 + p03 * v2_3;
    acc1_1 += p00 * v2_4 + p01 * v2_5 + p02 * v2_6 + p03 * v2_7;

    acc1_0 += p10 * v3_0 + p11 * v3_1 + p12 * v3_2 + p13 * v3_3;
    acc1_1 += p10 * v3_4 + p11 * v3_5 + p12 * v3_6 + p13 * v3_7;
}

static inline void extract_v_mcg_fast(ulong A, thread float v[8]) {
    const uint A_hi = uint(A >> 32);
    const uint A_lo = uint(A);
    v[0] = decode_state_mcg((A_hi >> 16) & 0xffffu);
    v[1] = decode_state_mcg((A_hi >> 13) & 0xffffu);
    v[2] = decode_state_mcg((A_hi >> 10) & 0xffffu);
    v[3] = decode_state_mcg((A_hi >> 7) & 0xffffu);
    v[4] = decode_state_mcg((A_hi >> 4) & 0xffffu);
    v[5] = decode_state_mcg((A_hi >> 1) & 0xffffu);
    v[6] = decode_state_mcg(((A_hi << 2) | (A_lo >> 30)) & 0xffffu);
    v[7] = decode_state_mcg(((A_hi << 5) | (A_lo >> 27)) & 0xffffu);
}

kernel void linear_gemv_ishizuki_k3_colmajor(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
        float acc0 = 0.0f;
        float acc1 = 0.0f;
        // In column-major layout: column tn has tiles_k contiguous tiles
        const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        uint tk = sg;
        for (; tk + 3 * SG < tiles_k; tk += 4u * SG) {
            const device uint *t0 = column + (tk + 0 * SG) * stride;
            const device uint *t1 = column + (tk + 1 * SG) * stride;
            const device uint *t2 = column + (tk + 2 * SG) * stride;
            const device uint *t3 = column + (tk + 3 * SG) * stride;

            const ulong w0a = t0[j0], w0b = t0[j1];
            const ulong w1a = t1[j0], w1b = t1[j1];
            const ulong w2a = t2[j0], w2b = t2[j1];
            const ulong w3a = t3[j0], w3b = t3[j1];

            const ulong A0 = ((w0a << 32) | w0b) << sh0;
            const ulong A1 = ((w1a << 32) | w1b) << sh0;
            const ulong A2 = ((w2a << 32) | w2b) << sh0;
            const ulong A3 = ((w3a << 32) | w3b) << sh0;

            const device half *xr0 = x + (tk + 0 * SG) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1 * SG) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
            const device half *xr2 = x + (tk + 2 * SG) * 16u + r0;
            const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
            const device half *xr3 = x + (tk + 3 * SG) * 16u + r0;
            const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

            float v0[8], v1[8], v2[8], v3[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint r = i * KA + 16u;
                v0[i] = decode_state(uint(A0 >> (64u - r)) & 0xffffu, CB);
                v1[i] = decode_state(uint(A1 >> (64u - r)) & 0xffffu, CB);
                v2[i] = decode_state(uint(A2 >> (64u - r)) & 0xffffu, CB);
                v3[i] = decode_state(uint(A3 >> (64u - r)) & 0xffffu, CB);
            }

            acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
            acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
            acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
            acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
            acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
            acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
            acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
            acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
        }

        for (; tk < tiles_k; tk += SG) {
            const device uint *t0 = column + tk * stride;
            const ulong a0 = t0[j0], a1 = t0[j1];
            const ulong A0 = ((a0 << 32) | a1) << sh0;
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
            float v[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint r = i * KA + 16u;
                const uint s = uint(A0 >> (64u - r));
                v[i] = decode_state(s & 0xffffu, CB);
            }
            acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
            acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
        }

        acc0 += simd_shuffle_xor(acc0, 1u);
        acc0 += simd_shuffle_xor(acc0, 2u);
        acc1 += simd_shuffle_xor(acc1, 1u);
        acc1 += simd_shuffle_xor(acc1, 2u);
        if (lane % 4u == 0u) {
            red[sg][lane / 4u] = acc0;
            red[sg][lane / 4u + 8u] = acc1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 16u) {
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[g][lid];
            }
            y[tn * 16u + lid] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_simd(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
        float acc0 = 0.0f;
        float acc1 = 0.0f;
        const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        uint tk = sg;
        for (; tk + 3 * SG < tiles_k; tk += 4u * SG) {
            const device uint *t0 = column + (tk + 0 * SG) * stride;
            const device uint *t1 = column + (tk + 1 * SG) * stride;
            const device uint *t2 = column + (tk + 2 * SG) * stride;
            const device uint *t3 = column + (tk + 3 * SG) * stride;

            const uint rw0 = (lane < 24u) ? t0[lane] : 0u;
            const uint rw1 = (lane < 24u) ? t1[lane] : 0u;
            const uint rw2 = (lane < 24u) ? t2[lane] : 0u;
            const uint rw3 = (lane < 24u) ? t3[lane] : 0u;

            const ulong w0a = simd_shuffle(rw0, j0), w0b = simd_shuffle(rw0, j1);
            const ulong w1a = simd_shuffle(rw1, j0), w1b = simd_shuffle(rw1, j1);
            const ulong w2a = simd_shuffle(rw2, j0), w2b = simd_shuffle(rw2, j1);
            const ulong w3a = simd_shuffle(rw3, j0), w3b = simd_shuffle(rw3, j1);

            const ulong A0 = ((w0a << 32) | w0b) << sh0;
            const ulong A1 = ((w1a << 32) | w1b) << sh0;
            const ulong A2 = ((w2a << 32) | w2b) << sh0;
            const ulong A3 = ((w3a << 32) | w3b) << sh0;

            const device half *xr0 = x + (tk + 0 * SG) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1 * SG) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
            const device half *xr2 = x + (tk + 2 * SG) * 16u + r0;
            const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
            const device half *xr3 = x + (tk + 3 * SG) * 16u + r0;
            const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

            float v0[8], v1[8], v2[8], v3[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint r = i * KA + 16u;
                v0[i] = decode_state(uint(A0 >> (64u - r)) & 0xffffu, CB);
                v1[i] = decode_state(uint(A1 >> (64u - r)) & 0xffffu, CB);
                v2[i] = decode_state(uint(A2 >> (64u - r)) & 0xffffu, CB);
                v3[i] = decode_state(uint(A3 >> (64u - r)) & 0xffffu, CB);
            }

            acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
            acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
            acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
            acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
            acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
            acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
            acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
            acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
        }

        for (; tk < tiles_k; tk += SG) {
            const device uint *t0 = column + tk * stride;
            const uint rw0 = (lane < 24u) ? t0[lane] : 0u;
            const ulong a0 = simd_shuffle(rw0, j0), a1 = simd_shuffle(rw0, j1);
            const ulong A0 = ((a0 << 32) | a1) << sh0;
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
            float v[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint r = i * KA + 16u;
                const uint s = uint(A0 >> (64u - r));
                v[i] = decode_state(s & 0xffffu, CB);
            }
            acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
            acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
        }

        acc0 += simd_shuffle_xor(acc0, 1u);
        acc0 += simd_shuffle_xor(acc0, 2u);
        acc1 += simd_shuffle_xor(acc1, 1u);
        acc1 += simd_shuffle_xor(acc1, 2u);
        if (lane % 4u == 0u) {
            red[sg][lane / 4u] = acc0;
            red[sg][lane / 4u + 8u] = acc1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 16u) {
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[g][lid];
            }
            y[tn * 16u + lid] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_fused2(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device half *x [[buffer(2)]],
    device float *y_a [[buffer(3)]],
    device float *y_b [[buffer(4)]],
    constant const uint *shape [[buffer(5)]], // [K, N_a, N_b]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint N_b = shape[2];
    const uint tiles_a = N_a / 16u;
    const uint tiles_b = N_b / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const bool is_b = (tgid >= tiles_a);
    const uint tn = is_b ? (tgid - tiles_a) : tgid;
    if (is_b && tn >= tiles_b) return;

    const device ushort *packed = is_b ? packed_b : packed_a;
    device float *y = is_b ? y_b : y_a;

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    const uint step = SG * 4u;
    const uint k_unroll_end = (tiles_k / step) * step;

    uint tk = sg * 4u;
    for (; tk < k_unroll_end; tk += step) {
        const device uint *t0 = column + (tk + 0u) * stride;
        const device uint *t1 = column + (tk + 1u) * stride;
        const device uint *t2 = column + (tk + 2u) * stride;
        const device uint *t3 = column + (tk + 3u) * stride;

        const uint w0a = t0[j0], w0b = t0[j1];
        const uint w1a = t1[j0], w1b = t1[j1];
        const uint w2a = t2[j0], w2b = t2[j1];
        const uint w3a = t3[j0], w3b = t3[j1];

        const device half *xr0 = x + (tk + 0u) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1u) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
        const device half *xr2 = x + (tk + 2u) * 16u + r0;
        const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
        const device half *xr3 = x + (tk + 3u) * 16u + r0;
        const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

        float v0[8], v1[8], v2[8], v3[8];
        extract_v_mcg_32(w0a, w0b, sh0, rsh0, v0);
        extract_v_mcg_32(w1a, w1b, sh0, rsh0, v1);
        extract_v_mcg_32(w2a, w2b, sh0, rsh0, v2);
        extract_v_mcg_32(w3a, w3b, sh0, rsh0, v3);

        acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
        acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
        acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
        acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
        acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
        acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
        acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
        acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
    }

    for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
        const device uint *t0 = column + tk * stride;
        const uint a0 = t0[j0], a1 = t0[j1];
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        extract_v_mcg_32(a0, a1, sh0, rsh0, v);
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[tn * 16u + lid] = sum;
    }
}

kernel void linear_gemv_ishizuki_k3_fused2_2col(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device half *x [[buffer(2)]],
    device float *y_a [[buffer(3)]],
    device float *y_b [[buffer(4)]],
    constant const uint *shape [[buffer(5)]], // [K, N_a, N_b]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint N_b = shape[2];
    const uint tiles_a = N_a / 16u;
    const uint tiles_b = N_b / 16u;
    const uint tiles_k = K / 16u;
    const uint pairs_a = tiles_a / 2u;
    const uint pairs_b = tiles_b / 2u;
    const uint total_pairs = pairs_a + pairs_b;
    constexpr int SG = 8;
    threadgroup float red[2][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tg = tgid; tg < total_pairs; tg += ntg) {
        const bool is_b = (tg >= pairs_a);
        const uint pair_idx = is_b ? (tg - pairs_a) : tg;
        const uint tn0 = pair_idx * 2u;
        const uint tn1 = tn0 + 1u;
        const device ushort *packed = is_b ? packed_b : packed_a;
        device float *y = is_b ? y_b : y_a;

        float acc0_0 = 0.0f;
        float acc0_1 = 0.0f;
        float acc1_0 = 0.0f;
        float acc1_1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn0 * (tiles_k * WORDS);
        const device uint *col1 = (const device uint *)packed + tn1 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 2u;
        uint w0_0_0 = 0, w0_0_1 = 0, w1_0_0 = 0, w1_0_1 = 0;
        uint w0_1_0 = 0, w0_1_1 = 0, w1_1_0 = 0, w1_1_1 = 0;
        float p00 = 0, p01 = 0, p02 = 0, p03 = 0, p10 = 0, p11 = 0, p12 = 0, p13 = 0;
        if (tk + 3u * step < k_unroll_end) {
            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;
            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;
            w0_0_0 = t0_0[j0]; w0_0_1 = t0_0[j1];
            w1_0_0 = t1_0[j0]; w1_0_1 = t1_0[j1];
            w0_1_0 = t0_1[j0]; w0_1_1 = t0_1[j1];
            w1_1_0 = t1_1[j0]; w1_1_1 = t1_1[j1];
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            p00 = float(xr0[0]); p01 = float(xr0[1]); p02 = float(xr0[8]); p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            p10 = float(xr1[0]); p11 = float(xr1[1]); p12 = float(xr1[8]); p13 = float(xr1[9]);
        }

        for (; tk + 3u * step < k_unroll_end; tk += 4u * step) {
            // 1. Prefetch Trip 1 words and activations ahead of Trip 0 compute
            const uint tk1 = tk + step;
            const device uint *u0_0 = col0 + (tk1 + 0u) * stride;
            const device uint *u1_0 = col0 + (tk1 + 1u) * stride;
            const device uint *u0_1 = col1 + (tk1 + 0u) * stride;
            const device uint *u1_1 = col1 + (tk1 + 1u) * stride;
            const uint x0_0_0 = u0_0[j0], x0_0_1 = u0_0[j1];
            const uint x1_0_0 = u1_0[j0], x1_0_1 = u1_0[j1];
            const uint x0_1_0 = u0_1[j0], x0_1_1 = u0_1[j1];
            const uint x1_1_0 = u1_1[j0], x1_1_1 = u1_1[j1];
            const device half *xr0b = x + (tk1 + 0u) * 16u + r0;
            const float q00 = float(xr0b[0]), q01 = float(xr0b[1]), q02 = float(xr0b[8]), q03 = float(xr0b[9]);
            const device half *xr1b = x + (tk1 + 1u) * 16u + r0;
            const float q10 = float(xr1b[0]), q11 = float(xr1b[1]), q12 = float(xr1b[8]), q13 = float(xr1b[9]);

            // Trip 0: compute using preloaded w... and p...
            decode_and_accum_4tile_2col(
                w0_0_0, w0_0_1, w1_0_0, w1_0_1,
                w0_1_0, w0_1_1, w1_1_0, w1_1_1,
                sh0, rsh0,
                p00, p01, p02, p03,
                p10, p11, p12, p13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 2. Prefetch Trip 2 words and activations ahead of Trip 1 compute
            const uint tk2 = tk + 2u * step;
            const device uint *y0_0 = col0 + (tk2 + 0u) * stride;
            const device uint *y1_0 = col0 + (tk2 + 1u) * stride;
            const device uint *y0_1 = col1 + (tk2 + 0u) * stride;
            const device uint *y1_1 = col1 + (tk2 + 1u) * stride;
            const uint y0_0_0 = y0_0[j0], y0_0_1 = y0_0[j1];
            const uint y1_0_0 = y1_0[j0], y1_0_1 = y1_0[j1];
            const uint y0_1_0 = y0_1[j0], y0_1_1 = y0_1[j1];
            const uint y1_1_0 = y1_1[j0], y1_1_1 = y1_1[j1];
            const device half *xr0c = x + (tk2 + 0u) * 16u + r0;
            const float r00 = float(xr0c[0]), r01 = float(xr0c[1]), r02 = float(xr0c[8]), r03 = float(xr0c[9]);
            const device half *xr1c = x + (tk2 + 1u) * 16u + r0;
            const float r10 = float(xr1c[0]), r11 = float(xr1c[1]), r12 = float(xr1c[8]), r13 = float(xr1c[9]);

            // Trip 1: compute using preloaded x... and q...
            decode_and_accum_4tile_2col(
                x0_0_0, x0_0_1, x1_0_0, x1_0_1,
                x0_1_0, x0_1_1, x1_1_0, x1_1_1,
                sh0, rsh0,
                q00, q01, q02, q03,
                q10, q11, q12, q13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 3. Prefetch Trip 3 words and activations ahead of Trip 2 compute
            const uint tk3 = tk + 3u * step;
            const device uint *z0_0 = col0 + (tk3 + 0u) * stride;
            const device uint *z1_0 = col0 + (tk3 + 1u) * stride;
            const device uint *z0_1 = col1 + (tk3 + 0u) * stride;
            const device uint *z1_1 = col1 + (tk3 + 1u) * stride;
            const uint z0_0_0 = z0_0[j0], z0_0_1 = z0_0[j1];
            const uint z1_0_0 = z1_0[j0], z1_0_1 = z1_0[j1];
            const uint z0_1_0 = z0_1[j0], z0_1_1 = z0_1[j1];
            const uint z1_1_0 = z1_1[j0], z1_1_1 = z1_1[j1];
            const device half *xr0d = x + (tk3 + 0u) * 16u + r0;
            const float s00 = float(xr0d[0]), s01 = float(xr0d[1]), s02 = float(xr0d[8]), s03 = float(xr0d[9]);
            const device half *xr1d = x + (tk3 + 1u) * 16u + r0;
            const float s10 = float(xr1d[0]), s11 = float(xr1d[1]), s12 = float(xr1d[8]), s13 = float(xr1d[9]);

            // Trip 2: compute using preloaded y... and r...
            decode_and_accum_4tile_2col(
                y0_0_0, y0_0_1, y1_0_0, y1_0_1,
                y0_1_0, y0_1_1, y1_1_0, y1_1_1,
                sh0, rsh0,
                r00, r01, r02, r03,
                r10, r11, r12, r13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 4. Prefetch next iteration's Trip 0 if there is another iteration
            const uint next_tk = tk + 4u * step;
            if (next_tk + 3u * step < k_unroll_end) {
                const device uint *next_t0_0 = col0 + (next_tk + 0u) * stride;
                const device uint *next_t1_0 = col0 + (next_tk + 1u) * stride;
                const device uint *next_t0_1 = col1 + (next_tk + 0u) * stride;
                const device uint *next_t1_1 = col1 + (next_tk + 1u) * stride;
                w0_0_0 = next_t0_0[j0]; w0_0_1 = next_t0_0[j1];
                w1_0_0 = next_t1_0[j0]; w1_0_1 = next_t1_0[j1];
                w0_1_0 = next_t0_1[j0]; w0_1_1 = next_t0_1[j1];
                w1_1_0 = next_t1_1[j0]; w1_1_1 = next_t1_1[j1];
                const device half *next_xr0 = x + (next_tk + 0u) * 16u + r0;
                p00 = float(next_xr0[0]); p01 = float(next_xr0[1]); p02 = float(next_xr0[8]); p03 = float(next_xr0[9]);
                const device half *next_xr1 = x + (next_tk + 1u) * 16u + r0;
                p10 = float(next_xr1[0]); p11 = float(next_xr1[1]); p12 = float(next_xr1[8]); p13 = float(next_xr1[9]);
            }

            // Trip 3: compute using preloaded z... and s...
            decode_and_accum_4tile_2col(
                z0_0_0, z0_0_1, z1_0_0, z1_0_1,
                z0_1_0, z0_1_1, z1_1_0, z1_1_1,
                sh0, rsh0,
                s00, s01, s02, s03,
                s10, s11, s12, s13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );
        }

        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];

            decode_and_accum_4tile_2col(
                w0_0_0, w0_0_1, w1_0_0, w1_0_1,
                w0_1_0, w0_1_1, w1_1_0, w1_1_1,
                sh0, rsh0,
                p00, p01, p02, p03,
                p10, p11, p12, p13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_0 = col0 + tk * stride;
            const uint a0_0 = t0_0[j0], a1_0 = t0_0[j1];
            float v_0[8];
            extract_v_mcg_32(a0_0, a1_0, sh0, rsh0, v_0);
            acc0_0 += p0 * v_0[0] + p1 * v_0[1] + p2 * v_0[2] + p3 * v_0[3];
            acc0_1 += p0 * v_0[4] + p1 * v_0[5] + p2 * v_0[6] + p3 * v_0[7];

            const device uint *t0_1 = col1 + tk * stride;
            const uint a0_1 = t0_1[j0], a1_1 = t0_1[j1];
            float v_1[8];
            extract_v_mcg_32(a0_1, a1_1, sh0, rsh0, v_1);
            acc1_0 += p0 * v_1[0] + p1 * v_1[1] + p2 * v_1[2] + p3 * v_1[3];
            acc1_1 += p0 * v_1[4] + p1 * v_1[5] + p2 * v_1[6] + p3 * v_1[7];
        }

        acc0_0 += simd_shuffle_xor(acc0_0, 1u);
        acc0_0 += simd_shuffle_xor(acc0_0, 2u);
        acc0_1 += simd_shuffle_xor(acc0_1, 1u);
        acc0_1 += simd_shuffle_xor(acc0_1, 2u);

        acc1_0 += simd_shuffle_xor(acc1_0, 1u);
        acc1_0 += simd_shuffle_xor(acc1_0, 2u);
        acc1_1 += simd_shuffle_xor(acc1_1, 1u);
        acc1_1 += simd_shuffle_xor(acc1_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc0_0;
            red[0][sg][lane / 4u + 8u] = acc0_1;
            red[1][sg][lane / 4u] = acc1_0;
            red[1][sg][lane / 4u + 8u] = acc1_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 32u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            const uint out_tn = (col_idx == 0u) ? tn0 : tn1;
            y[out_tn * 16u + out_lane] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_fused2_4col(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device half *x [[buffer(2)]],
    device float *y_a [[buffer(3)]],
    device float *y_b [[buffer(4)]],
    constant const uint *shape [[buffer(5)]], // [K, N_a, N_b]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint N_b = shape[2];
    const uint tiles_a = N_a / 16u;
    const uint tiles_b = N_b / 16u;
    const uint tiles_k = K / 16u;
    const uint quads_a = tiles_a / 4u;
    const uint quads_b = tiles_b / 4u;
    const uint total_quads = quads_a + quads_b;
    constexpr int SG = 8;
    threadgroup float red[4][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tg = tgid; tg < total_quads; tg += ntg) {
        const bool is_b = (tg >= quads_a);
        const uint quad_idx = is_b ? (tg - quads_a) : tg;
        const uint tn0 = quad_idx * 4u;
        const uint tn1 = tn0 + 1u;
        const uint tn2 = tn0 + 2u;
        const uint tn3 = tn0 + 3u;
        const device ushort *packed = is_b ? packed_b : packed_a;
        device float *y = is_b ? y_b : y_a;

        float acc0_0 = 0.0f;
        float acc0_1 = 0.0f;
        float acc1_0 = 0.0f;
        float acc1_1 = 0.0f;
        float acc2_0 = 0.0f;
        float acc2_1 = 0.0f;
        float acc3_0 = 0.0f;
        float acc3_1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn0 * (tiles_k * WORDS);
        const device uint *col1 = (const device uint *)packed + tn1 * (tiles_k * WORDS);
        const device uint *col2 = (const device uint *)packed + tn2 * (tiles_k * WORDS);
        const device uint *col3 = (const device uint *)packed + tn3 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 2u;
        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;
            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;
            const device uint *t0_2 = col2 + (tk + 0u) * stride;
            const device uint *t1_2 = col2 + (tk + 1u) * stride;
            const device uint *t0_3 = col3 + (tk + 0u) * stride;
            const device uint *t1_3 = col3 + (tk + 1u) * stride;

            float v[8];

            // Burst-load every word before the first use, exactly as
            // `_fused2_2col` (:491-495) and the T4.3 hoist in
            // `_colmajor_2col_sk2` (:2477-2480) do.
            //
            // This is not cosmetic. As written this kernel inlines the index
            // expression into each `extract_v_mcg_32(...)` call, so it holds ONE
            // word pair in flight where `_2col` holds four. An A/B without this
            // hoist measures the absence of the hoist, not column tiling, and a
            // loss would be uninterpretable.
            //
            // Bit-exact by construction: only *when* the loads are issued moves.
            // Each column's accumulation order and the reduction tree below are
            // untouched.
            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];
            const uint w0_2_0 = t0_2[j0], w0_2_1 = t0_2[j1];
            const uint w1_2_0 = t1_2[j0], w1_2_1 = t1_2[j1];
            const uint w0_3_0 = t0_3[j0], w0_3_1 = t0_3[j1];
            const uint w1_3_0 = t1_3[j0], w1_3_1 = t1_3[j1];

            // Col 0: 2 contiguous sub-steps along K
            extract_v_mcg_32(w0_0_0, w0_0_1, sh0, rsh0, v);
            acc0_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc0_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];
            extract_v_mcg_32(w1_0_0, w1_0_1, sh0, rsh0, v);
            acc0_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc0_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            // Col 1: 2 contiguous sub-steps along K
            extract_v_mcg_32(w0_1_0, w0_1_1, sh0, rsh0, v);
            acc1_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];
            extract_v_mcg_32(w1_1_0, w1_1_1, sh0, rsh0, v);
            acc1_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            // Col 2: 2 contiguous sub-steps along K
            extract_v_mcg_32(w0_2_0, w0_2_1, sh0, rsh0, v);
            acc2_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc2_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];
            extract_v_mcg_32(w1_2_0, w1_2_1, sh0, rsh0, v);
            acc2_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc2_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            // Col 3: 2 contiguous sub-steps along K
            extract_v_mcg_32(w0_3_0, w0_3_1, sh0, rsh0, v);
            acc3_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc3_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];
            extract_v_mcg_32(w1_3_0, w1_3_1, sh0, rsh0, v);
            acc3_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc3_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_0 = col0 + tk * stride;
            float v_0[8];
            extract_v_mcg_32(t0_0[j0], t0_0[j1], sh0, rsh0, v_0);
            acc0_0 += p0 * v_0[0] + p1 * v_0[1] + p2 * v_0[2] + p3 * v_0[3];
            acc0_1 += p0 * v_0[4] + p1 * v_0[5] + p2 * v_0[6] + p3 * v_0[7];

            const device uint *t0_1 = col1 + tk * stride;
            float v_1[8];
            extract_v_mcg_32(t0_1[j0], t0_1[j1], sh0, rsh0, v_1);
            acc1_0 += p0 * v_1[0] + p1 * v_1[1] + p2 * v_1[2] + p3 * v_1[3];
            acc1_1 += p0 * v_1[4] + p1 * v_1[5] + p2 * v_1[6] + p3 * v_1[7];

            const device uint *t0_2 = col2 + tk * stride;
            float v_2[8];
            extract_v_mcg_32(t0_2[j0], t0_2[j1], sh0, rsh0, v_2);
            acc2_0 += p0 * v_2[0] + p1 * v_2[1] + p2 * v_2[2] + p3 * v_2[3];
            acc2_1 += p0 * v_2[4] + p1 * v_2[5] + p2 * v_2[6] + p3 * v_2[7];

            const device uint *t0_3 = col3 + tk * stride;
            float v_3[8];
            extract_v_mcg_32(t0_3[j0], t0_3[j1], sh0, rsh0, v_3);
            acc3_0 += p0 * v_3[0] + p1 * v_3[1] + p2 * v_3[2] + p3 * v_3[3];
            acc3_1 += p0 * v_3[4] + p1 * v_3[5] + p2 * v_3[6] + p3 * v_3[7];
        }

        acc0_0 += simd_shuffle_xor(acc0_0, 1u);
        acc0_0 += simd_shuffle_xor(acc0_0, 2u);
        acc0_1 += simd_shuffle_xor(acc0_1, 1u);
        acc0_1 += simd_shuffle_xor(acc0_1, 2u);

        acc1_0 += simd_shuffle_xor(acc1_0, 1u);
        acc1_0 += simd_shuffle_xor(acc1_0, 2u);
        acc1_1 += simd_shuffle_xor(acc1_1, 1u);
        acc1_1 += simd_shuffle_xor(acc1_1, 2u);

        acc2_0 += simd_shuffle_xor(acc2_0, 1u);
        acc2_0 += simd_shuffle_xor(acc2_0, 2u);
        acc2_1 += simd_shuffle_xor(acc2_1, 1u);
        acc2_1 += simd_shuffle_xor(acc2_1, 2u);

        acc3_0 += simd_shuffle_xor(acc3_0, 1u);
        acc3_0 += simd_shuffle_xor(acc3_0, 2u);
        acc3_1 += simd_shuffle_xor(acc3_1, 1u);
        acc3_1 += simd_shuffle_xor(acc3_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc0_0;
            red[0][sg][lane / 4u + 8u] = acc0_1;
            red[1][sg][lane / 4u] = acc1_0;
            red[1][sg][lane / 4u + 8u] = acc1_1;
            red[2][sg][lane / 4u] = acc2_0;
            red[2][sg][lane / 4u + 8u] = acc2_1;
            red[3][sg][lane / 4u] = acc3_0;
            red[3][sg][lane / 4u + 8u] = acc3_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 64u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            const uint out_tn = tn0 + col_idx;
            y[out_tn * 16u + out_lane] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_fused2_co(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device half *x [[buffer(2)]],
    device float *y_a [[buffer(3)]],
    device float *y_b [[buffer(4)]],
    constant const uint *shape [[buffer(5)]], // [K, N_a, N_b]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint tiles_a = N_a / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[2][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < tiles_a; tn += ntg) {
        float acc_a0 = 0.0f;
        float acc_a1 = 0.0f;
        float acc_b0 = 0.0f;
        float acc_b1 = 0.0f;

        const device uint *col_a = (const device uint *)packed_a + tn * (tiles_k * WORDS);
        const device uint *col_b = (const device uint *)packed_b + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 2u;
        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_a = col_a + (tk + 0u) * stride;
            const device uint *t1_a = col_a + (tk + 1u) * stride;

            const device uint *t0_b = col_b + (tk + 0u) * stride;
            const device uint *t1_b = col_b + (tk + 1u) * stride;

            // Load Col A and Col B weights concurrently (8 words in flight)
            const uint w0_a0 = t0_a[j0], w0_a1 = t0_a[j1];
            const uint w1_a0 = t1_a[j0], w1_a1 = t1_a[j1];
            const uint w0_b0 = t0_b[j0], w0_b1 = t0_b[j1];
            const uint w1_b0 = t1_b[j0], w1_b1 = t1_b[j1];

            float v[8];

            // Col A: 2 contiguous sub-steps along K
            extract_v_mcg_32(w0_a0, w0_a1, sh0, rsh0, v);
            acc_a0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc_a1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_a0, w1_a1, sh0, rsh0, v);
            acc_a0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc_a1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            // Col B: 2 contiguous sub-steps along K
            extract_v_mcg_32(w0_b0, w0_b1, sh0, rsh0, v);
            acc_b0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc_b1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_b0, w1_b1, sh0, rsh0, v);
            acc_b0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc_b1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_a = col_a + tk * stride;
            const uint a0_a = t0_a[j0], a1_a = t0_a[j1];
            float v_a[8];
            extract_v_mcg_32(a0_a, a1_a, sh0, rsh0, v_a);
            acc_a0 += p0 * v_a[0] + p1 * v_a[1] + p2 * v_a[2] + p3 * v_a[3];
            acc_a1 += p0 * v_a[4] + p1 * v_a[5] + p2 * v_a[6] + p3 * v_a[7];

            const device uint *t0_b = col_b + tk * stride;
            const uint a0_b = t0_b[j0], a1_b = t0_b[j1];
            float v_b[8];
            extract_v_mcg_32(a0_b, a1_b, sh0, rsh0, v_b);
            acc_b0 += p0 * v_b[0] + p1 * v_b[1] + p2 * v_b[2] + p3 * v_b[3];
            acc_b1 += p0 * v_b[4] + p1 * v_b[5] + p2 * v_b[6] + p3 * v_b[7];
        }

        acc_a0 += simd_shuffle_xor(acc_a0, 1u);
        acc_a0 += simd_shuffle_xor(acc_a0, 2u);
        acc_a1 += simd_shuffle_xor(acc_a1, 1u);
        acc_a1 += simd_shuffle_xor(acc_a1, 2u);

        acc_b0 += simd_shuffle_xor(acc_b0, 1u);
        acc_b0 += simd_shuffle_xor(acc_b0, 2u);
        acc_b1 += simd_shuffle_xor(acc_b1, 1u);
        acc_b1 += simd_shuffle_xor(acc_b1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc_a0;
            red[0][sg][lane / 4u + 8u] = acc_a1;
            red[1][sg][lane / 4u] = acc_b0;
            red[1][sg][lane / 4u + 8u] = acc_b1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 32u) {
            const uint tensor_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[tensor_idx][g][out_lane];
            }
            if (tensor_idx == 0u) {
                y_a[tn * 16u + out_lane] = sum;
            } else {
                y_b[tn * 16u + out_lane] = sum;
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_fused2_co4(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device half *x [[buffer(2)]],
    device float *y_a [[buffer(3)]],
    device float *y_b [[buffer(4)]],
    constant const uint *shape [[buffer(5)]], // [K, N_a, N_b]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint tiles_a = N_a / 16u;
    const uint tiles_k = K / 16u;
    const uint pairs_a = tiles_a / 2u;
    constexpr int SG = 8;
    threadgroup float red[4][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < pairs_a; tn += ntg) {
        const uint tn0 = tn * 2u;
        const uint tn1 = tn0 + 1u;

        float acc_a0_0 = 0.0f;
        float acc_a0_1 = 0.0f;
        float acc_a1_0 = 0.0f;
        float acc_a1_1 = 0.0f;

        float acc_b0_0 = 0.0f;
        float acc_b0_1 = 0.0f;
        float acc_b1_0 = 0.0f;
        float acc_b1_1 = 0.0f;

        const device uint *col_a0 = (const device uint *)packed_a + tn0 * (tiles_k * WORDS);
        const device uint *col_a1 = (const device uint *)packed_a + tn1 * (tiles_k * WORDS);
        const device uint *col_b0 = (const device uint *)packed_b + tn0 * (tiles_k * WORDS);
        const device uint *col_b1 = (const device uint *)packed_b + tn1 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 4u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 4u;
        #pragma unroll(2)
        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
            const device half *xr2 = x + (tk + 2u) * 16u + r0;
            const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
            const device half *xr3 = x + (tk + 3u) * 16u + r0;
            const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

            const device uint *t0_a0 = col_a0 + (tk + 0u) * stride;
            const device uint *t1_a0 = col_a0 + (tk + 1u) * stride;
            const device uint *t2_a0 = col_a0 + (tk + 2u) * stride;
            const device uint *t3_a0 = col_a0 + (tk + 3u) * stride;

            const device uint *t0_a1 = col_a1 + (tk + 0u) * stride;
            const device uint *t1_a1 = col_a1 + (tk + 1u) * stride;
            const device uint *t2_a1 = col_a1 + (tk + 2u) * stride;
            const device uint *t3_a1 = col_a1 + (tk + 3u) * stride;

            const device uint *t0_b0 = col_b0 + (tk + 0u) * stride;
            const device uint *t1_b0 = col_b0 + (tk + 1u) * stride;
            const device uint *t2_b0 = col_b0 + (tk + 2u) * stride;
            const device uint *t3_b0 = col_b0 + (tk + 3u) * stride;

            const device uint *t0_b1 = col_b1 + (tk + 0u) * stride;
            const device uint *t1_b1 = col_b1 + (tk + 1u) * stride;
            const device uint *t2_b1 = col_b1 + (tk + 2u) * stride;
            const device uint *t3_b1 = col_b1 + (tk + 3u) * stride;

            float v[8];

            // Col A0: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_a0[j0], t0_a0[j1], sh0, rsh0, v);
            acc_a0_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc_a0_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_a0[j0], t1_a0[j1], sh0, rsh0, v);
            acc_a0_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc_a0_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_a0[j0], t2_a0[j1], sh0, rsh0, v);
            acc_a0_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc_a0_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_a0[j0], t3_a0[j1], sh0, rsh0, v);
            acc_a0_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc_a0_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];

            // Col A1: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_a1[j0], t0_a1[j1], sh0, rsh0, v);
            acc_a1_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc_a1_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_a1[j0], t1_a1[j1], sh0, rsh0, v);
            acc_a1_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc_a1_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_a1[j0], t2_a1[j1], sh0, rsh0, v);
            acc_a1_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc_a1_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_a1[j0], t3_a1[j1], sh0, rsh0, v);
            acc_a1_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc_a1_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];

            // Col B0: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_b0[j0], t0_b0[j1], sh0, rsh0, v);
            acc_b0_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc_b0_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_b0[j0], t1_b0[j1], sh0, rsh0, v);
            acc_b0_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc_b0_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_b0[j0], t2_b0[j1], sh0, rsh0, v);
            acc_b0_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc_b0_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_b0[j0], t3_b0[j1], sh0, rsh0, v);
            acc_b0_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc_b0_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];

            // Col B1: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_b1[j0], t0_b1[j1], sh0, rsh0, v);
            acc_b1_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc_b1_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_b1[j0], t1_b1[j1], sh0, rsh0, v);
            acc_b1_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc_b1_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_b1[j0], t2_b1[j1], sh0, rsh0, v);
            acc_b1_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc_b1_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_b1[j0], t3_b1[j1], sh0, rsh0, v);
            acc_b1_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc_b1_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_a0 = col_a0 + tk * stride;
            float v_a0[8];
            extract_v_mcg_32(t0_a0[j0], t0_a0[j1], sh0, rsh0, v_a0);
            acc_a0_0 += p0 * v_a0[0] + p1 * v_a0[1] + p2 * v_a0[2] + p3 * v_a0[3];
            acc_a0_1 += p0 * v_a0[4] + p1 * v_a0[5] + p2 * v_a0[6] + p3 * v_a0[7];

            const device uint *t0_a1 = col_a1 + tk * stride;
            float v_a1[8];
            extract_v_mcg_32(t0_a1[j0], t0_a1[j1], sh0, rsh0, v_a1);
            acc_a1_0 += p0 * v_a1[0] + p1 * v_a1[1] + p2 * v_a1[2] + p3 * v_a1[3];
            acc_a1_1 += p0 * v_a1[4] + p1 * v_a1[5] + p2 * v_a1[6] + p3 * v_a1[7];

            const device uint *t0_b0 = col_b0 + tk * stride;
            float v_b0[8];
            extract_v_mcg_32(t0_b0[j0], t0_b0[j1], sh0, rsh0, v_b0);
            acc_b0_0 += p0 * v_b0[0] + p1 * v_b0[1] + p2 * v_b0[2] + p3 * v_b0[3];
            acc_b0_1 += p0 * v_b0[4] + p1 * v_b0[5] + p2 * v_b0[6] + p3 * v_b0[7];

            const device uint *t0_b1 = col_b1 + tk * stride;
            float v_b1[8];
            extract_v_mcg_32(t0_b1[j0], t0_b1[j1], sh0, rsh0, v_b1);
            acc_b1_0 += p0 * v_b1[0] + p1 * v_b1[1] + p2 * v_b1[2] + p3 * v_b1[3];
            acc_b1_1 += p0 * v_b1[4] + p1 * v_b1[5] + p2 * v_b1[6] + p3 * v_b1[7];
        }

        acc_a0_0 += simd_shuffle_xor(acc_a0_0, 1u);
        acc_a0_0 += simd_shuffle_xor(acc_a0_0, 2u);
        acc_a0_1 += simd_shuffle_xor(acc_a0_1, 1u);
        acc_a0_1 += simd_shuffle_xor(acc_a0_1, 2u);

        acc_a1_0 += simd_shuffle_xor(acc_a1_0, 1u);
        acc_a1_0 += simd_shuffle_xor(acc_a1_0, 2u);
        acc_a1_1 += simd_shuffle_xor(acc_a1_1, 1u);
        acc_a1_1 += simd_shuffle_xor(acc_a1_1, 2u);

        acc_b0_0 += simd_shuffle_xor(acc_b0_0, 1u);
        acc_b0_0 += simd_shuffle_xor(acc_b0_0, 2u);
        acc_b0_1 += simd_shuffle_xor(acc_b0_1, 1u);
        acc_b0_1 += simd_shuffle_xor(acc_b0_1, 2u);

        acc_b1_0 += simd_shuffle_xor(acc_b1_0, 1u);
        acc_b1_0 += simd_shuffle_xor(acc_b1_0, 2u);
        acc_b1_1 += simd_shuffle_xor(acc_b1_1, 1u);
        acc_b1_1 += simd_shuffle_xor(acc_b1_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc_a0_0;
            red[0][sg][lane / 4u + 8u] = acc_a0_1;
            red[1][sg][lane / 4u] = acc_a1_0;
            red[1][sg][lane / 4u + 8u] = acc_a1_1;
            red[2][sg][lane / 4u] = acc_b0_0;
            red[2][sg][lane / 4u + 8u] = acc_b0_1;
            red[3][sg][lane / 4u] = acc_b1_0;
            red[3][sg][lane / 4u + 8u] = acc_b1_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 64u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            if (col_idx == 0u) {
                y_a[tn0 * 16u + out_lane] = sum;
            } else if (col_idx == 1u) {
                y_a[tn1 * 16u + out_lane] = sum;
            } else if (col_idx == 2u) {
                y_b[tn0 * 16u + out_lane] = sum;
            } else {
                y_b[tn1 * 16u + out_lane] = sum;
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_fused2_sk2(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device half *x [[buffer(2)]],
    device float *y_a [[buffer(3)]],
    device float *y_b [[buffer(4)]],
    constant const uint *shape [[buffer(5)]], // [K, N_a, N_b]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint N_b = shape[2];
    const uint tiles_a = N_a / 16u;
    const uint tiles_b = N_b / 16u;
    const uint total_tiles = tiles_a + tiles_b;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    constexpr uint SK = 2u;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint tg_tile = tgid % total_tiles;
    const uint sk = tgid / total_tiles;
    if (sk >= SK) return;

    const bool is_b = (tg_tile >= tiles_a);
    const uint tn = is_b ? (tg_tile - tiles_a) : tg_tile;
    if (is_b && tn >= tiles_b) return;

    const device ushort *packed = is_b ? packed_b : packed_a;
    device float *y = is_b ? y_b : y_a;
    const uint N_curr = is_b ? N_b : N_a;

    const uint k_per_split = ((tiles_k / SK) / 32u) * 32u;
    const uint k_start = sk * k_per_split;
    const uint k_end = (sk == SK - 1u) ? tiles_k : (k_start + k_per_split);

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    const uint step = SG * 4u;
    const uint k_unroll_end = k_start + ((k_end - k_start) / step) * step;

    uint tk = k_start + sg * 4u;
    for (; tk < k_unroll_end; tk += step) {
        const device uint *t0 = column + (tk + 0u) * stride;
        const device uint *t1 = column + (tk + 1u) * stride;
        const device uint *t2 = column + (tk + 2u) * stride;
        const device uint *t3 = column + (tk + 3u) * stride;

        const ulong w0a = t0[j0], w0b = t0[j1];
        const ulong w1a = t1[j0], w1b = t1[j1];
        const ulong w2a = t2[j0], w2b = t2[j1];
        const ulong w3a = t3[j0], w3b = t3[j1];

        const ulong A0 = ((w0a << 32) | w0b) << sh0;
        const ulong A1 = ((w1a << 32) | w1b) << sh0;
        const ulong A2 = ((w2a << 32) | w2b) << sh0;
        const ulong A3 = ((w3a << 32) | w3b) << sh0;

        const device half *xr0 = x + (tk + 0u) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1u) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
        const device half *xr2 = x + (tk + 2u) * 16u + r0;
        const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
        const device half *xr3 = x + (tk + 3u) * 16u + r0;
        const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

        float v0[8], v1[8], v2[8], v3[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v0[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
            v1[i] = decode_state_mcg(uint(A1 >> (64u - rad)) & 0xffffu);
            v2[i] = decode_state_mcg(uint(A2 >> (64u - rad)) & 0xffffu);
            v3[i] = decode_state_mcg(uint(A3 >> (64u - rad)) & 0xffffu);
        }

        acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
        acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
        acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
        acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
        acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
        acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
        acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
        acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
    }

    for (tk = k_unroll_end + sg; tk < k_end; tk += SG) {
        const device uint *t0 = column + tk * stride;
        const ulong a0 = t0[j0], a1 = t0[j1];
        const ulong A0 = ((a0 << 32) | a1) << sh0;
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
        }
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[(sk * N_curr) + tn * 16u + lid] = sum;
    }
}


kernel void linear_gemv_ishizuki_k3_fused3(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device ushort *packed_c [[buffer(2)]],
    const device half *x [[buffer(3)]],
    device float *y_a [[buffer(4)]],
    device float *y_b [[buffer(5)]],
    device float *y_c [[buffer(6)]],
    constant const uint *shape [[buffer(7)]], // [K, N_a, N_b, N_c]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint N_b = shape[2];
    const uint N_c = shape[3];
    const uint tiles_a = N_a / 16u;
    const uint tiles_b = N_b / 16u;
    const uint tiles_c = N_c / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const device ushort *packed;
    device float *y;
    uint tn;

    if (tgid < tiles_a) {
        packed = packed_a;
        y = y_a;
        tn = tgid;
    } else if (tgid < tiles_a + tiles_b) {
        packed = packed_b;
        y = y_b;
        tn = tgid - tiles_a;
    } else {
        packed = packed_c;
        y = y_c;
        tn = tgid - (tiles_a + tiles_b);
        if (tn >= tiles_c) return;
    }

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    const uint step = SG * 4u;
    const uint k_unroll_end = (tiles_k / step) * step;

    uint tk = sg * 4u;
    for (; tk < k_unroll_end; tk += step) {
        const device uint *t0 = column + (tk + 0u) * stride;
        const device uint *t1 = column + (tk + 1u) * stride;
        const device uint *t2 = column + (tk + 2u) * stride;
        const device uint *t3 = column + (tk + 3u) * stride;

        const device half *xr0 = x + (tk + 0u) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1u) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
        const device half *xr2 = x + (tk + 2u) * 16u + r0;
        const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
        const device half *xr3 = x + (tk + 3u) * 16u + r0;
        const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

        float v[8];
        extract_v_mcg_32(t0[j0], t0[j1], sh0, rsh0, v);
        acc0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
        acc1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

        extract_v_mcg_32(t1[j0], t1[j1], sh0, rsh0, v);
        acc0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
        acc1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

        extract_v_mcg_32(t2[j0], t2[j1], sh0, rsh0, v);
        acc0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
        acc1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

        extract_v_mcg_32(t3[j0], t3[j1], sh0, rsh0, v);
        acc0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
        acc1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];
    }

    for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
        const device uint *t0 = column + tk * stride;
        const uint a0 = t0[j0], a1 = t0[j1];
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        extract_v_mcg_32(a0, a1, sh0, rsh0, v);
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[tn * 16u + lid] = sum;
    }
}

kernel void linear_gemv_ishizuki_k3_fused3_2col(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device ushort *packed_c [[buffer(2)]],
    const device half *x [[buffer(3)]],
    device float *y_a [[buffer(4)]],
    device float *y_b [[buffer(5)]],
    device float *y_c [[buffer(6)]],
    constant const uint *shape [[buffer(7)]], // [K, N_a, N_b, N_c]
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint N_b = shape[2];
    const uint N_c = shape[3];
    const uint tiles_a = N_a / 16u;
    const uint tiles_b = N_b / 16u;
    const uint tiles_c = N_c / 16u;
    const uint tiles_k = K / 16u;
    const uint pairs_a = tiles_a / 2u;
    const uint pairs_b = tiles_b / 2u;
    const uint pairs_c = tiles_c / 2u;
    const uint total_pairs = pairs_a + pairs_b + pairs_c;
    constexpr int SG = 8;
    threadgroup float red[2][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tg = tgid; tg < total_pairs; tg += ntg) {
        const device ushort *packed;
        device float *y;
        uint tn0, tn1;

        if (tg < pairs_a) {
            packed = packed_a;
            y = y_a;
            tn0 = tg * 2u;
            tn1 = tn0 + 1u;
        } else if (tg < pairs_a + pairs_b) {
            packed = packed_b;
            y = y_b;
            tn0 = (tg - pairs_a) * 2u;
            tn1 = tn0 + 1u;
        } else {
            packed = packed_c;
            y = y_c;
            tn0 = (tg - (pairs_a + pairs_b)) * 2u;
            tn1 = tn0 + 1u;
        }

        float acc0_0 = 0.0f;
        float acc0_1 = 0.0f;
        float acc1_0 = 0.0f;
        float acc1_1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn0 * (tiles_k * WORDS);
        const device uint *col1 = (const device uint *)packed + tn1 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 2u;
        uint w0_0_0 = 0, w0_0_1 = 0, w1_0_0 = 0, w1_0_1 = 0;
        uint w0_1_0 = 0, w0_1_1 = 0, w1_1_0 = 0, w1_1_1 = 0;
        float p00 = 0, p01 = 0, p02 = 0, p03 = 0, p10 = 0, p11 = 0, p12 = 0, p13 = 0;
        if (tk + 3u * step < k_unroll_end) {
            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;
            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;
            w0_0_0 = t0_0[j0]; w0_0_1 = t0_0[j1];
            w1_0_0 = t1_0[j0]; w1_0_1 = t1_0[j1];
            w0_1_0 = t0_1[j0]; w0_1_1 = t0_1[j1];
            w1_1_0 = t1_1[j0]; w1_1_1 = t1_1[j1];
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            p00 = float(xr0[0]); p01 = float(xr0[1]); p02 = float(xr0[8]); p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            p10 = float(xr1[0]); p11 = float(xr1[1]); p12 = float(xr1[8]); p13 = float(xr1[9]);
        }

        for (; tk + 3u * step < k_unroll_end; tk += 4u * step) {
            // 1. Prefetch Trip 1 words and activations ahead of Trip 0 compute
            const uint tk1 = tk + step;
            const device uint *u0_0 = col0 + (tk1 + 0u) * stride;
            const device uint *u1_0 = col0 + (tk1 + 1u) * stride;
            const device uint *u0_1 = col1 + (tk1 + 0u) * stride;
            const device uint *u1_1 = col1 + (tk1 + 1u) * stride;
            const uint x0_0_0 = u0_0[j0], x0_0_1 = u0_0[j1];
            const uint x1_0_0 = u1_0[j0], x1_0_1 = u1_0[j1];
            const uint x0_1_0 = u0_1[j0], x0_1_1 = u0_1[j1];
            const uint x1_1_0 = u1_1[j0], x1_1_1 = u1_1[j1];
            const device half *xr0b = x + (tk1 + 0u) * 16u + r0;
            const float q00 = float(xr0b[0]), q01 = float(xr0b[1]), q02 = float(xr0b[8]), q03 = float(xr0b[9]);
            const device half *xr1b = x + (tk1 + 1u) * 16u + r0;
            const float q10 = float(xr1b[0]), q11 = float(xr1b[1]), q12 = float(xr1b[8]), q13 = float(xr1b[9]);

            // Trip 0: compute using preloaded w... and p...
            decode_and_accum_4tile_2col(
                w0_0_0, w0_0_1, w1_0_0, w1_0_1,
                w0_1_0, w0_1_1, w1_1_0, w1_1_1,
                sh0, rsh0,
                p00, p01, p02, p03,
                p10, p11, p12, p13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 2. Prefetch Trip 2 words and activations ahead of Trip 1 compute
            const uint tk2 = tk + 2u * step;
            const device uint *y0_0 = col0 + (tk2 + 0u) * stride;
            const device uint *y1_0 = col0 + (tk2 + 1u) * stride;
            const device uint *y0_1 = col1 + (tk2 + 0u) * stride;
            const device uint *y1_1 = col1 + (tk2 + 1u) * stride;
            const uint y0_0_0 = y0_0[j0], y0_0_1 = y0_0[j1];
            const uint y1_0_0 = y1_0[j0], y1_0_1 = y1_0[j1];
            const uint y0_1_0 = y0_1[j0], y0_1_1 = y0_1[j1];
            const uint y1_1_0 = y1_1[j0], y1_1_1 = y1_1[j1];
            const device half *xr0c = x + (tk2 + 0u) * 16u + r0;
            const float r00 = float(xr0c[0]), r01 = float(xr0c[1]), r02 = float(xr0c[8]), r03 = float(xr0c[9]);
            const device half *xr1c = x + (tk2 + 1u) * 16u + r0;
            const float r10 = float(xr1c[0]), r11 = float(xr1c[1]), r12 = float(xr1c[8]), r13 = float(xr1c[9]);

            // Trip 1: compute using preloaded x... and q...
            decode_and_accum_4tile_2col(
                x0_0_0, x0_0_1, x1_0_0, x1_0_1,
                x0_1_0, x0_1_1, x1_1_0, x1_1_1,
                sh0, rsh0,
                q00, q01, q02, q03,
                q10, q11, q12, q13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 3. Prefetch Trip 3 words and activations ahead of Trip 2 compute
            const uint tk3 = tk + 3u * step;
            const device uint *z0_0 = col0 + (tk3 + 0u) * stride;
            const device uint *z1_0 = col0 + (tk3 + 1u) * stride;
            const device uint *z0_1 = col1 + (tk3 + 0u) * stride;
            const device uint *z1_1 = col1 + (tk3 + 1u) * stride;
            const uint z0_0_0 = z0_0[j0], z0_0_1 = z0_0[j1];
            const uint z1_0_0 = z1_0[j0], z1_0_1 = z1_0[j1];
            const uint z0_1_0 = z0_1[j0], z0_1_1 = z0_1[j1];
            const uint z1_1_0 = z1_1[j0], z1_1_1 = z1_1[j1];
            const device half *xr0d = x + (tk3 + 0u) * 16u + r0;
            const float s00 = float(xr0d[0]), s01 = float(xr0d[1]), s02 = float(xr0d[8]), s03 = float(xr0d[9]);
            const device half *xr1d = x + (tk3 + 1u) * 16u + r0;
            const float s10 = float(xr1d[0]), s11 = float(xr1d[1]), s12 = float(xr1d[8]), s13 = float(xr1d[9]);

            // Trip 2: compute using preloaded y... and r...
            decode_and_accum_4tile_2col(
                y0_0_0, y0_0_1, y1_0_0, y1_0_1,
                y0_1_0, y0_1_1, y1_1_0, y1_1_1,
                sh0, rsh0,
                r00, r01, r02, r03,
                r10, r11, r12, r13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 4. Prefetch next iteration's Trip 0 if there is another iteration
            const uint next_tk = tk + 4u * step;
            if (next_tk + 3u * step < k_unroll_end) {
                const device uint *next_t0_0 = col0 + (next_tk + 0u) * stride;
                const device uint *next_t1_0 = col0 + (next_tk + 1u) * stride;
                const device uint *next_t0_1 = col1 + (next_tk + 0u) * stride;
                const device uint *next_t1_1 = col1 + (next_tk + 1u) * stride;
                w0_0_0 = next_t0_0[j0]; w0_0_1 = next_t0_0[j1];
                w1_0_0 = next_t1_0[j0]; w1_0_1 = next_t1_0[j1];
                w0_1_0 = next_t0_1[j0]; w0_1_1 = next_t0_1[j1];
                w1_1_0 = next_t1_1[j0]; w1_1_1 = next_t1_1[j1];
                const device half *next_xr0 = x + (next_tk + 0u) * 16u + r0;
                p00 = float(next_xr0[0]); p01 = float(next_xr0[1]); p02 = float(next_xr0[8]); p03 = float(next_xr0[9]);
                const device half *next_xr1 = x + (next_tk + 1u) * 16u + r0;
                p10 = float(next_xr1[0]); p11 = float(next_xr1[1]); p12 = float(next_xr1[8]); p13 = float(next_xr1[9]);
            }

            // Trip 3: compute using preloaded z... and s...
            decode_and_accum_4tile_2col(
                z0_0_0, z0_0_1, z1_0_0, z1_0_1,
                z0_1_0, z0_1_1, z1_1_0, z1_1_1,
                sh0, rsh0,
                s00, s01, s02, s03,
                s10, s11, s12, s13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );
        }

        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];

            decode_and_accum_4tile_2col(
                w0_0_0, w0_0_1, w1_0_0, w1_0_1,
                w0_1_0, w0_1_1, w1_1_0, w1_1_1,
                sh0, rsh0,
                p00, p01, p02, p03,
                p10, p11, p12, p13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_0 = col0 + tk * stride;
            const uint a0_0 = t0_0[j0], a1_0 = t0_0[j1];
            float v_0[8];
            extract_v_mcg_32(a0_0, a1_0, sh0, rsh0, v_0);
            acc0_0 += p0 * v_0[0] + p1 * v_0[1] + p2 * v_0[2] + p3 * v_0[3];
            acc0_1 += p0 * v_0[4] + p1 * v_0[5] + p2 * v_0[6] + p3 * v_0[7];

            const device uint *t0_1 = col1 + tk * stride;
            const uint a0_1 = t0_1[j0], a1_1 = t0_1[j1];
            float v_1[8];
            extract_v_mcg_32(a0_1, a1_1, sh0, rsh0, v_1);
            acc1_0 += p0 * v_1[0] + p1 * v_1[1] + p2 * v_1[2] + p3 * v_1[3];
            acc1_1 += p0 * v_1[4] + p1 * v_1[5] + p2 * v_1[6] + p3 * v_1[7];
        }

        acc0_0 += simd_shuffle_xor(acc0_0, 1u);
        acc0_0 += simd_shuffle_xor(acc0_0, 2u);
        acc0_1 += simd_shuffle_xor(acc0_1, 1u);
        acc0_1 += simd_shuffle_xor(acc0_1, 2u);

        acc1_0 += simd_shuffle_xor(acc1_0, 1u);
        acc1_0 += simd_shuffle_xor(acc1_0, 2u);
        acc1_1 += simd_shuffle_xor(acc1_1, 1u);
        acc1_1 += simd_shuffle_xor(acc1_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc0_0;
            red[0][sg][lane / 4u + 8u] = acc0_1;
            red[1][sg][lane / 4u] = acc1_0;
            red[1][sg][lane / 4u + 8u] = acc1_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 32u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            const uint out_tn = (col_idx == 0u) ? tn0 : tn1;
            y[out_tn * 16u + out_lane] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_fused3_sk2(
    const device ushort *packed_a [[buffer(0)]],
    const device ushort *packed_b [[buffer(1)]],
    const device ushort *packed_c [[buffer(2)]],
    const device half *x [[buffer(3)]],
    device float *y_a [[buffer(4)]],
    device float *y_b [[buffer(5)]],
    device float *y_c [[buffer(6)]],
    constant const uint *shape [[buffer(7)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N_a = shape[1];
    const uint N_b = shape[2];
    const uint N_c = shape[3];
    const uint tiles_a = N_a / 16u;
    const uint tiles_b = N_b / 16u;
    const uint tiles_c = N_c / 16u;
    const uint total_tiles = tiles_a + tiles_b + tiles_c;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    constexpr uint SK = 2u;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint tg_tile = tgid % total_tiles;
    const uint sk = tgid / total_tiles;
    if (sk >= SK) return;

    const device ushort *packed;
    device float *y;
    uint tn;
    uint N_curr;

    if (tg_tile < tiles_a) {
        packed = packed_a;
        y = y_a;
        tn = tg_tile;
        N_curr = N_a;
    } else if (tg_tile < tiles_a + tiles_b) {
        packed = packed_b;
        y = y_b;
        tn = tg_tile - tiles_a;
        N_curr = N_b;
    } else {
        packed = packed_c;
        y = y_c;
        tn = tg_tile - (tiles_a + tiles_b);
        N_curr = N_c;
        if (tn >= tiles_c) return;
    }

    const uint k_per_split = ((tiles_k / SK) / 32u) * 32u;
    const uint k_start = sk * k_per_split;
    const uint k_end = (sk == SK - 1u) ? tiles_k : (k_start + k_per_split);

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    const uint step = SG * 4u;
    const uint k_unroll_end = k_start + ((k_end - k_start) / step) * step;

    uint tk = k_start + sg * 4u;
    for (; tk < k_unroll_end; tk += step) {
        const device uint *t0 = column + (tk + 0u) * stride;
        const device uint *t1 = column + (tk + 1u) * stride;
        const device uint *t2 = column + (tk + 2u) * stride;
        const device uint *t3 = column + (tk + 3u) * stride;

        const ulong w0a = t0[j0], w0b = t0[j1];
        const ulong w1a = t1[j0], w1b = t1[j1];
        const ulong w2a = t2[j0], w2b = t2[j1];
        const ulong w3a = t3[j0], w3b = t3[j1];

        const ulong A0 = ((w0a << 32) | w0b) << sh0;
        const ulong A1 = ((w1a << 32) | w1b) << sh0;
        const ulong A2 = ((w2a << 32) | w2b) << sh0;
        const ulong A3 = ((w3a << 32) | w3b) << sh0;

        const device half *xr0 = x + (tk + 0u) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1u) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
        const device half *xr2 = x + (tk + 2u) * 16u + r0;
        const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
        const device half *xr3 = x + (tk + 3u) * 16u + r0;
        const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

        float v0[8], v1[8], v2[8], v3[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v0[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
            v1[i] = decode_state_mcg(uint(A1 >> (64u - rad)) & 0xffffu);
            v2[i] = decode_state_mcg(uint(A2 >> (64u - rad)) & 0xffffu);
            v3[i] = decode_state_mcg(uint(A3 >> (64u - rad)) & 0xffffu);
        }

        acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
        acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
        acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
        acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
        acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
        acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
        acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
        acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
    }

    for (tk = k_unroll_end + sg; tk < k_end; tk += SG) {
        const device uint *t0 = column + tk * stride;
        const ulong a0 = t0[j0], a1 = t0[j1];
        const ulong A0 = ((a0 << 32) | a1) << sh0;
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
        }
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[(sk * N_curr) + tn * 16u + lid] = sum;
    }
}


kernel void linear_gemv_ishizuki_k3_colmajor_stream(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr uint SG = 8u;
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint tn = tgid * SG + sg;
    if (tn >= tiles_n) return;

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    uint tk = 0u;
    for (; tk + 3u < tiles_k; tk += 4u) {
        const device uint *t0 = column + (tk + 0u) * stride;
        const device uint *t1 = column + (tk + 1u) * stride;
        const device uint *t2 = column + (tk + 2u) * stride;
        const device uint *t3 = column + (tk + 3u) * stride;

        const ulong w0a = t0[j0], w0b = t0[j1];
        const ulong w1a = t1[j0], w1b = t1[j1];
        const ulong w2a = t2[j0], w2b = t2[j1];
        const ulong w3a = t3[j0], w3b = t3[j1];

        const ulong A0 = ((w0a << 32) | w0b) << sh0;
        const ulong A1 = ((w1a << 32) | w1b) << sh0;
        const ulong A2 = ((w2a << 32) | w2b) << sh0;
        const ulong A3 = ((w3a << 32) | w3b) << sh0;

        const device half *xr0 = x + (tk + 0u) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1u) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
        const device half *xr2 = x + (tk + 2u) * 16u + r0;
        const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
        const device half *xr3 = x + (tk + 3u) * 16u + r0;
        const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

        float v0[8], v1[8], v2[8], v3[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint r = i * KA + 16u;
            v0[i] = decode_state(uint(A0 >> (64u - r)) & 0xffffu, CB);
            v1[i] = decode_state(uint(A1 >> (64u - r)) & 0xffffu, CB);
            v2[i] = decode_state(uint(A2 >> (64u - r)) & 0xffffu, CB);
            v3[i] = decode_state(uint(A3 >> (64u - r)) & 0xffffu, CB);
        }
        acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
        acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
        acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
        acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
        acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
        acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
        acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
        acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
    }

    for (; tk < tiles_k; ++tk) {
        const device uint *t0 = column + tk * stride;
        const ulong a0 = t0[j0], a1 = t0[j1];
        const ulong A0 = ((a0 << 32) | a1) << sh0;
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint r = i * KA + 16u;
            const uint s = uint(A0 >> (64u - r));
            v[i] = decode_state(s & 0xffffu, CB);
        }
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);

    if (lane % 4u == 0u) {
        const uint row_idx = lane / 4u;
        y[tn * 16u + row_idx] = acc0;
        y[tn * 16u + row_idx + 8u] = acc1;
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_sk4(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    constexpr uint SK = 4u;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint tn = tgid % tiles_n;
    const uint sk = tgid / tiles_n;
    if (sk >= SK) return;

    const uint k_per_split = (tiles_k + SK - 1u) / SK;
    const uint k_start = sk * k_per_split;
    const uint k_end = min(k_start + k_per_split, tiles_k);

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    uint tk = k_start + sg;
    for (; tk + SG < k_end; tk += 2u * SG) {
        const device uint *t0 = column + (tk + 0 * SG) * stride;
        const device uint *t1 = column + (tk + 1 * SG) * stride;

        const ulong w0a = t0[j0], w0b = t0[j1];
        const ulong w1a = t1[j0], w1b = t1[j1];

        const ulong A0 = ((w0a << 32) | w0b) << sh0;
        const ulong A1 = ((w1a << 32) | w1b) << sh0;

        const device half *xr0 = x + (tk + 0 * SG) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1 * SG) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint r = i * KA + 16u;
            v[i] = decode_state(uint(A0 >> (64u - r)) & 0xffffu, CB);
        }
        acc0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
        acc1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint r = i * KA + 16u;
            v[i] = decode_state(uint(A1 >> (64u - r)) & 0xffffu, CB);
        }
        acc0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
        acc1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
    }

    for (; tk < k_end; tk += SG) {
        const device uint *t0 = column + tk * stride;
        const ulong a0 = t0[j0], a1 = t0[j1];
        const ulong A0 = ((a0 << 32) | a1) << sh0;
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint r = i * KA + 16u;
            v[i] = decode_state(uint(A0 >> (64u - r)) & 0xffffu, CB);
        }
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }
    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[(sk * N) + tn * 16u + lid] = sum;
    }
}

kernel void gemv_reduce_sk2(
    const device float *partials [[buffer(0)]],
    device float *y [[buffer(1)]],
    constant const uint &n [[buffer(2)]],
    uint gid [[thread_position_in_grid]]) {
    if (gid < n) {
        y[gid] = partials[gid] + partials[n + gid];
    }
}

kernel void gemv_reduce_sk4(
    const device float *partials [[buffer(0)]],
    device float *y [[buffer(1)]],
    constant const uint &n [[buffer(2)]],
    uint gid [[thread_position_in_grid]]) {
    if (gid < n) {
        y[gid] = partials[gid] + partials[n + gid] + partials[2u * n + gid] + partials[3u * n + gid];
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_contig4(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
        float acc0 = 0.0f;
        float acc1 = 0.0f;
        const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 4u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 4u;
        for (; tk < k_unroll_end; tk += step) {
            const device uint *t0 = column + (tk + 0u) * stride;
            const device uint *t1 = column + (tk + 1u) * stride;
            const device uint *t2 = column + (tk + 2u) * stride;
            const device uint *t3 = column + (tk + 3u) * stride;
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
            const device half *xr2 = x + (tk + 2u) * 16u + r0;
            const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
            const device half *xr3 = x + (tk + 3u) * 16u + r0;
            const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

            float v[8];
            extract_v_mcg_32(t0[j0], t0[j1], sh0, rsh0, v);
            acc0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1[j0], t1[j1], sh0, rsh0, v);
            acc0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2[j0], t2[j1], sh0, rsh0, v);
            acc0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3[j0], t3[j1], sh0, rsh0, v);
            acc0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device uint *t0 = column + tk * stride;
            const uint a0 = t0[j0], a1 = t0[j1];
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
            float v[8];
            extract_v_mcg_32(a0, a1, sh0, rsh0, v);
            acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
            acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
        }

        acc0 += simd_shuffle_xor(acc0, 1u);
        acc0 += simd_shuffle_xor(acc0, 2u);
        acc1 += simd_shuffle_xor(acc1, 1u);
        acc1 += simd_shuffle_xor(acc1, 2u);
        if (lane % 4u == 0u) {
            red[sg][lane / 4u] = acc0;
            red[sg][lane / 4u + 8u] = acc1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 16u) {
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[g][lid];
            }
            y[tn * 16u + lid] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_2col(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    const uint pairs_n = tiles_n / 2u;
    constexpr int SG = 8;
    threadgroup float red[2][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < pairs_n; tn += ntg) {
        const uint tn0 = tn * 2u;
        const uint tn1 = tn0 + 1u;

        float acc0_0 = 0.0f;
        float acc0_1 = 0.0f;
        float acc1_0 = 0.0f;
        float acc1_1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn0 * (tiles_k * WORDS);
        const device uint *col1 = (const device uint *)packed + tn1 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 2u;
        uint w0_0_0 = 0, w0_0_1 = 0, w1_0_0 = 0, w1_0_1 = 0;
        uint w0_1_0 = 0, w0_1_1 = 0, w1_1_0 = 0, w1_1_1 = 0;
        float p00 = 0, p01 = 0, p02 = 0, p03 = 0, p10 = 0, p11 = 0, p12 = 0, p13 = 0;
        if (tk + 3u * step < k_unroll_end) {
            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;
            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;
            w0_0_0 = t0_0[j0]; w0_0_1 = t0_0[j1];
            w1_0_0 = t1_0[j0]; w1_0_1 = t1_0[j1];
            w0_1_0 = t0_1[j0]; w0_1_1 = t0_1[j1];
            w1_1_0 = t1_1[j0]; w1_1_1 = t1_1[j1];
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            p00 = float(xr0[0]); p01 = float(xr0[1]); p02 = float(xr0[8]); p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            p10 = float(xr1[0]); p11 = float(xr1[1]); p12 = float(xr1[8]); p13 = float(xr1[9]);
        }

        for (; tk + 3u * step < k_unroll_end; tk += 4u * step) {
            // 1. Prefetch Trip 1 words and activations ahead of Trip 0 compute
            const uint tk1 = tk + step;
            const device uint *u0_0 = col0 + (tk1 + 0u) * stride;
            const device uint *u1_0 = col0 + (tk1 + 1u) * stride;
            const device uint *u0_1 = col1 + (tk1 + 0u) * stride;
            const device uint *u1_1 = col1 + (tk1 + 1u) * stride;
            const uint x0_0_0 = u0_0[j0], x0_0_1 = u0_0[j1];
            const uint x1_0_0 = u1_0[j0], x1_0_1 = u1_0[j1];
            const uint x0_1_0 = u0_1[j0], x0_1_1 = u0_1[j1];
            const uint x1_1_0 = u1_1[j0], x1_1_1 = u1_1[j1];
            const device half *xr0b = x + (tk1 + 0u) * 16u + r0;
            const float q00 = float(xr0b[0]), q01 = float(xr0b[1]), q02 = float(xr0b[8]), q03 = float(xr0b[9]);
            const device half *xr1b = x + (tk1 + 1u) * 16u + r0;
            const float q10 = float(xr1b[0]), q11 = float(xr1b[1]), q12 = float(xr1b[8]), q13 = float(xr1b[9]);

            // Trip 0: compute using preloaded w... and p...
            decode_and_accum_4tile_2col(
                w0_0_0, w0_0_1, w1_0_0, w1_0_1,
                w0_1_0, w0_1_1, w1_1_0, w1_1_1,
                sh0, rsh0,
                p00, p01, p02, p03,
                p10, p11, p12, p13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 2. Prefetch Trip 2 words and activations ahead of Trip 1 compute
            const uint tk2 = tk + 2u * step;
            const device uint *y0_0 = col0 + (tk2 + 0u) * stride;
            const device uint *y1_0 = col0 + (tk2 + 1u) * stride;
            const device uint *y0_1 = col1 + (tk2 + 0u) * stride;
            const device uint *y1_1 = col1 + (tk2 + 1u) * stride;
            const uint y0_0_0 = y0_0[j0], y0_0_1 = y0_0[j1];
            const uint y1_0_0 = y1_0[j0], y1_0_1 = y1_0[j1];
            const uint y0_1_0 = y0_1[j0], y0_1_1 = y0_1[j1];
            const uint y1_1_0 = y1_1[j0], y1_1_1 = y1_1[j1];
            const device half *xr0c = x + (tk2 + 0u) * 16u + r0;
            const float r00 = float(xr0c[0]), r01 = float(xr0c[1]), r02 = float(xr0c[8]), r03 = float(xr0c[9]);
            const device half *xr1c = x + (tk2 + 1u) * 16u + r0;
            const float r10 = float(xr1c[0]), r11 = float(xr1c[1]), r12 = float(xr1c[8]), r13 = float(xr1c[9]);

            // Trip 1: compute using preloaded x... and q...
            decode_and_accum_4tile_2col(
                x0_0_0, x0_0_1, x1_0_0, x1_0_1,
                x0_1_0, x0_1_1, x1_1_0, x1_1_1,
                sh0, rsh0,
                q00, q01, q02, q03,
                q10, q11, q12, q13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 3. Prefetch Trip 3 words and activations ahead of Trip 2 compute
            const uint tk3 = tk + 3u * step;
            const device uint *z0_0 = col0 + (tk3 + 0u) * stride;
            const device uint *z1_0 = col0 + (tk3 + 1u) * stride;
            const device uint *z0_1 = col1 + (tk3 + 0u) * stride;
            const device uint *z1_1 = col1 + (tk3 + 1u) * stride;
            const uint z0_0_0 = z0_0[j0], z0_0_1 = z0_0[j1];
            const uint z1_0_0 = z1_0[j0], z1_0_1 = z1_0[j1];
            const uint z0_1_0 = z0_1[j0], z0_1_1 = z0_1[j1];
            const uint z1_1_0 = z1_1[j0], z1_1_1 = z1_1[j1];
            const device half *xr0d = x + (tk3 + 0u) * 16u + r0;
            const float s00 = float(xr0d[0]), s01 = float(xr0d[1]), s02 = float(xr0d[8]), s03 = float(xr0d[9]);
            const device half *xr1d = x + (tk3 + 1u) * 16u + r0;
            const float s10 = float(xr1d[0]), s11 = float(xr1d[1]), s12 = float(xr1d[8]), s13 = float(xr1d[9]);

            // Trip 2: compute using preloaded y... and r...
            decode_and_accum_4tile_2col(
                y0_0_0, y0_0_1, y1_0_0, y1_0_1,
                y0_1_0, y0_1_1, y1_1_0, y1_1_1,
                sh0, rsh0,
                r00, r01, r02, r03,
                r10, r11, r12, r13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );

            // 4. Prefetch next iteration's Trip 0 if there is another iteration
            const uint next_tk = tk + 4u * step;
            if (next_tk + 3u * step < k_unroll_end) {
                const device uint *next_t0_0 = col0 + (next_tk + 0u) * stride;
                const device uint *next_t1_0 = col0 + (next_tk + 1u) * stride;
                const device uint *next_t0_1 = col1 + (next_tk + 0u) * stride;
                const device uint *next_t1_1 = col1 + (next_tk + 1u) * stride;
                w0_0_0 = next_t0_0[j0]; w0_0_1 = next_t0_0[j1];
                w1_0_0 = next_t1_0[j0]; w1_0_1 = next_t1_0[j1];
                w0_1_0 = next_t0_1[j0]; w0_1_1 = next_t0_1[j1];
                w1_1_0 = next_t1_1[j0]; w1_1_1 = next_t1_1[j1];
                const device half *next_xr0 = x + (next_tk + 0u) * 16u + r0;
                p00 = float(next_xr0[0]); p01 = float(next_xr0[1]); p02 = float(next_xr0[8]); p03 = float(next_xr0[9]);
                const device half *next_xr1 = x + (next_tk + 1u) * 16u + r0;
                p10 = float(next_xr1[0]); p11 = float(next_xr1[1]); p12 = float(next_xr1[8]); p13 = float(next_xr1[9]);
            }

            // Trip 3: compute using preloaded z... and s...
            decode_and_accum_4tile_2col(
                z0_0_0, z0_0_1, z1_0_0, z1_0_1,
                z0_1_0, z0_1_1, z1_1_0, z1_1_1,
                sh0, rsh0,
                s00, s01, s02, s03,
                s10, s11, s12, s13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );
        }
        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0s = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0s[0]), p01 = float(xr0s[1]), p02 = float(xr0s[8]), p03 = float(xr0s[9]);
            const device half *xr1s = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1s[0]), p11 = float(xr1s[1]), p12 = float(xr1s[8]), p13 = float(xr1s[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];

            decode_and_accum_4tile_2col(
                w0_0_0, w0_0_1, w1_0_0, w1_0_1,
                w0_1_0, w0_1_1, w1_1_0, w1_1_1,
                sh0, rsh0,
                p00, p01, p02, p03,
                p10, p11, p12, p13,
                acc0_0, acc0_1, acc1_0, acc1_1
            );
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_0 = col0 + tk * stride;
            const uint a0_0 = t0_0[j0], a1_0 = t0_0[j1];
            float v_0[8];
            extract_v_mcg_32(a0_0, a1_0, sh0, rsh0, v_0);
            acc0_0 += p0 * v_0[0] + p1 * v_0[1] + p2 * v_0[2] + p3 * v_0[3];
            acc0_1 += p0 * v_0[4] + p1 * v_0[5] + p2 * v_0[6] + p3 * v_0[7];

            const device uint *t0_1 = col1 + tk * stride;
            const uint a0_1 = t0_1[j0], a1_1 = t0_1[j1];
            float v_1[8];
            extract_v_mcg_32(a0_1, a1_1, sh0, rsh0, v_1);
            acc1_0 += p0 * v_1[0] + p1 * v_1[1] + p2 * v_1[2] + p3 * v_1[3];
            acc1_1 += p0 * v_1[4] + p1 * v_1[5] + p2 * v_1[6] + p3 * v_1[7];
        }

        acc0_0 += simd_shuffle_xor(acc0_0, 1u);
        acc0_0 += simd_shuffle_xor(acc0_0, 2u);
        acc0_1 += simd_shuffle_xor(acc0_1, 1u);
        acc0_1 += simd_shuffle_xor(acc0_1, 2u);

        acc1_0 += simd_shuffle_xor(acc1_0, 1u);
        acc1_0 += simd_shuffle_xor(acc1_0, 2u);
        acc1_1 += simd_shuffle_xor(acc1_1, 1u);
        acc1_1 += simd_shuffle_xor(acc1_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc0_0;
            red[0][sg][lane / 4u + 8u] = acc0_1;
            red[1][sg][lane / 4u] = acc1_0;
            red[1][sg][lane / 4u + 8u] = acc1_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 32u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            const uint out_tn = (col_idx == 0u) ? tn0 : tn1;
            y[out_tn * 16u + out_lane] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_1col(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
        float acc0 = 0.0f;
        float acc1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 2u;
        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            float v[8];

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];

            extract_v_mcg_32(w0_0_0, w0_0_1, sh0, rsh0, v);
            acc0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_0_0, w1_0_1, sh0, rsh0, v);
            acc0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
            const device uint *t0_0 = col0 + tk * stride;
            const uint a0 = t0_0[j0], a1 = t0_0[j1];
            float v[8];
            extract_v_mcg_32(a0, a1, sh0, rsh0, v);
            acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
            acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
        }

        acc0 += simd_shuffle_xor(acc0, 1u);
        acc0 += simd_shuffle_xor(acc0, 2u);
        acc1 += simd_shuffle_xor(acc1, 1u);
        acc1 += simd_shuffle_xor(acc1, 2u);

        if (lane % 4u == 0u) {
            red[sg][lane / 4u] = acc0;
            red[sg][lane / 4u + 8u] = acc1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 16u) {
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[g][lid];
            }
            y[tn * 16u + lid] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_1col_sk2(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    constexpr uint SK = 2u;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint total_groups = tiles_n * SK;
    for (uint tg = tgid; tg < total_groups; tg += ntg) {
        const uint tn = tg % tiles_n;
        const uint sk = tg / tiles_n;

        const uint k_per_split = tiles_k / SK;
        const uint k_start = sk * k_per_split;
        const uint k_end = k_start + k_per_split;

        float acc0 = 0.0f;
        float acc1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = k_start + ((k_end - k_start) / step) * step;

        uint tk = k_start + sg * 2u;
        for (; tk + step < k_unroll_end; tk += 2u * step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            float v[8];

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];

            extract_v_mcg_32(w0_0_0, w0_0_1, sh0, rsh0, v);
            acc0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_0_0, w1_0_1, sh0, rsh0, v);
            acc0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            // Second trip of the pair — tiles tk+step, tk+step+1 (same order).
            {
                const uint tkx = tk + step;
                const device half *xr0b = x + (tkx + 0u) * 16u + r0;
                const float q00 = float(xr0b[0]), q01 = float(xr0b[1]), q02 = float(xr0b[8]), q03 = float(xr0b[9]);
                const device half *xr1b = x + (tkx + 1u) * 16u + r0;
                const float q10 = float(xr1b[0]), q11 = float(xr1b[1]), q12 = float(xr1b[8]), q13 = float(xr1b[9]);

                const device uint *u0_0 = col0 + (tkx + 0u) * stride;
                const device uint *u1_0 = col0 + (tkx + 1u) * stride;

                const uint x0_0_0 = u0_0[j0], x0_0_1 = u0_0[j1];
                const uint x1_0_0 = u1_0[j0], x1_0_1 = u1_0[j1];

                extract_v_mcg_32(x0_0_0, x0_0_1, sh0, rsh0, v);
                acc0 += q00 * v[0] + q01 * v[1] + q02 * v[2] + q03 * v[3];
                acc1 += q00 * v[4] + q01 * v[5] + q02 * v[6] + q03 * v[7];

                extract_v_mcg_32(x1_0_0, x1_0_1, sh0, rsh0, v);
                acc0 += q10 * v[0] + q11 * v[1] + q12 * v[2] + q13 * v[3];
                acc1 += q10 * v[4] + q11 * v[5] + q12 * v[6] + q13 * v[7];
            }
        }

        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            float v[8];

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];

            extract_v_mcg_32(w0_0_0, w0_0_1, sh0, rsh0, v);
            acc0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_0_0, w1_0_1, sh0, rsh0, v);
            acc0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < k_end; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
            const device uint *t0_0 = col0 + tk * stride;
            const uint a0 = t0_0[j0], a1 = t0_0[j1];
            float v[8];
            extract_v_mcg_32(a0, a1, sh0, rsh0, v);
            acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
            acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
        }

        acc0 += simd_shuffle_xor(acc0, 1u);
        acc0 += simd_shuffle_xor(acc0, 2u);
        acc1 += simd_shuffle_xor(acc1, 1u);
        acc1 += simd_shuffle_xor(acc1, 2u);

        if (lane % 4u == 0u) {
            red[sg][lane / 4u] = acc0;
            red[sg][lane / 4u + 8u] = acc1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 16u) {
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[g][lid];
            }
            y[sk * N + tn * 16u + lid] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_2col_sk2(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    const uint pairs_n = tiles_n / 2u;
    constexpr int SG = 8;
    constexpr uint SK = 2u;
    threadgroup float red[2][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint total_groups = pairs_n * SK;
    for (uint tg = tgid; tg < total_groups; tg += ntg) {
        const uint tn = tg % pairs_n;
        const uint sk = tg / pairs_n;

        const uint k_per_split = tiles_k / SK;
        const uint k_start = sk * k_per_split;
        const uint k_end = k_start + k_per_split;

        const uint tn0 = tn * 2u;
        const uint tn1 = tn0 + 1u;

        float acc0_0 = 0.0f;
        float acc0_1 = 0.0f;
        float acc1_0 = 0.0f;
        float acc1_1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn0 * (tiles_k * WORDS);
        const device uint *col1 = (const device uint *)packed + tn1 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = k_start + ((k_end - k_start) / step) * step;

        uint tk = k_start + sg * 2u;
        for (; tk + 3u * step < k_unroll_end; tk += 4u * step) {
            // Trip 0: tk, tk+1
            {
                const device half *xr0 = x + (tk + 0u) * 16u + r0;
                const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
                const device half *xr1 = x + (tk + 1u) * 16u + r0;
                const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

                const device uint *t0_0 = col0 + (tk + 0u) * stride;
                const device uint *t1_0 = col0 + (tk + 1u) * stride;
                const device uint *t0_1 = col1 + (tk + 0u) * stride;
                const device uint *t1_1 = col1 + (tk + 1u) * stride;

                decode_and_accum_4tile_2col(
                    t0_0[j0], t0_0[j1],
                    t1_0[j0], t1_0[j1],
                    t0_1[j0], t0_1[j1],
                    t1_1[j0], t1_1[j1],
                    sh0, rsh0,
                    p00, p01, p02, p03,
                    p10, p11, p12, p13,
                    acc0_0, acc0_1,
                    acc1_0, acc1_1
                );
            }

            // Trip 1: tk+step, tk+step+1
            {
                const uint tkx = tk + step;
                const device half *xr0b = x + (tkx + 0u) * 16u + r0;
                const float q00 = float(xr0b[0]), q01 = float(xr0b[1]), q02 = float(xr0b[8]), q03 = float(xr0b[9]);
                const device half *xr1b = x + (tkx + 1u) * 16u + r0;
                const float q10 = float(xr1b[0]), q11 = float(xr1b[1]), q12 = float(xr1b[8]), q13 = float(xr1b[9]);

                const device uint *u0_0 = col0 + (tkx + 0u) * stride;
                const device uint *u1_0 = col0 + (tkx + 1u) * stride;
                const device uint *u0_1 = col1 + (tkx + 0u) * stride;
                const device uint *u1_1 = col1 + (tkx + 1u) * stride;

                decode_and_accum_4tile_2col(
                    u0_0[j0], u0_0[j1],
                    u1_0[j0], u1_0[j1],
                    u0_1[j0], u0_1[j1],
                    u1_1[j0], u1_1[j1],
                    sh0, rsh0,
                    q00, q01, q02, q03,
                    q10, q11, q12, q13,
                    acc0_0, acc0_1,
                    acc1_0, acc1_1
                );
            }

            // Trip 2: tk+2*step, tk+2*step+1
            {
                const uint tky = tk + 2u * step;
                const device half *xr0c = x + (tky + 0u) * 16u + r0;
                const float r00 = float(xr0c[0]), r01 = float(xr0c[1]), r02 = float(xr0c[8]), r03 = float(xr0c[9]);
                const device half *xr1c = x + (tky + 1u) * 16u + r0;
                const float r10 = float(xr1c[0]), r11 = float(xr1c[1]), r12 = float(xr1c[8]), r13 = float(xr1c[9]);

                const device uint *y0_0 = col0 + (tky + 0u) * stride;
                const device uint *y1_0 = col0 + (tky + 1u) * stride;
                const device uint *y0_1 = col1 + (tky + 0u) * stride;
                const device uint *y1_1 = col1 + (tky + 1u) * stride;

                decode_and_accum_4tile_2col(
                    y0_0[j0], y0_0[j1],
                    y1_0[j0], y1_0[j1],
                    y0_1[j0], y0_1[j1],
                    y1_1[j0], y1_1[j1],
                    sh0, rsh0,
                    r00, r01, r02, r03,
                    r10, r11, r12, r13,
                    acc0_0, acc0_1,
                    acc1_0, acc1_1
                );
            }

            // Trip 3: tk+3*step, tk+3*step+1
            {
                const uint tkz = tk + 3u * step;
                const device half *xr0d = x + (tkz + 0u) * 16u + r0;
                const float s00 = float(xr0d[0]), s01 = float(xr0d[1]), s02 = float(xr0d[8]), s03 = float(xr0d[9]);
                const device half *xr1d = x + (tkz + 1u) * 16u + r0;
                const float s10 = float(xr1d[0]), s11 = float(xr1d[1]), s12 = float(xr1d[8]), s13 = float(xr1d[9]);

                const device uint *z0_0 = col0 + (tkz + 0u) * stride;
                const device uint *z1_0 = col0 + (tkz + 1u) * stride;
                const device uint *z0_1 = col1 + (tkz + 0u) * stride;
                const device uint *z1_1 = col1 + (tkz + 1u) * stride;

                decode_and_accum_4tile_2col(
                    z0_0[j0], z0_0[j1],
                    z1_0[j0], z1_0[j1],
                    z0_1[j0], z0_1[j1],
                    z1_1[j0], z1_1[j1],
                    sh0, rsh0,
                    s00, s01, s02, s03,
                    s10, s11, s12, s13,
                    acc0_0, acc0_1,
                    acc1_0, acc1_1
                );
            }
        }


        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;

            float v[8];

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];

            extract_v_mcg_32(w0_0_0, w0_0_1, sh0, rsh0, v);
            acc0_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc0_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_0_0, w1_0_1, sh0, rsh0, v);
            acc0_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc0_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(w0_1_0, w0_1_1, sh0, rsh0, v);
            acc1_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_1_0, w1_1_1, sh0, rsh0, v);
            acc1_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < k_end; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_0 = col0 + tk * stride;
            const uint a0_0 = t0_0[j0], a1_0 = t0_0[j1];
            float v_0[8];
            extract_v_mcg_32(a0_0, a1_0, sh0, rsh0, v_0);
            acc0_0 += p0 * v_0[0] + p1 * v_0[1] + p2 * v_0[2] + p3 * v_0[3];
            acc0_1 += p0 * v_0[4] + p1 * v_0[5] + p2 * v_0[6] + p3 * v_0[7];

            const device uint *t0_1 = col1 + tk * stride;
            const uint a0_1 = t0_1[j0], a1_1 = t0_1[j1];
            float v_1[8];
            extract_v_mcg_32(a0_1, a1_1, sh0, rsh0, v_1);
            acc1_0 += p0 * v_1[0] + p1 * v_1[1] + p2 * v_1[2] + p3 * v_1[3];
            acc1_1 += p0 * v_1[4] + p1 * v_1[5] + p2 * v_1[6] + p3 * v_1[7];
        }

        acc0_0 += simd_shuffle_xor(acc0_0, 1u);
        acc0_0 += simd_shuffle_xor(acc0_0, 2u);
        acc0_1 += simd_shuffle_xor(acc0_1, 1u);
        acc0_1 += simd_shuffle_xor(acc0_1, 2u);

        acc1_0 += simd_shuffle_xor(acc1_0, 1u);
        acc1_0 += simd_shuffle_xor(acc1_0, 2u);
        acc1_1 += simd_shuffle_xor(acc1_1, 1u);
        acc1_1 += simd_shuffle_xor(acc1_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc0_0;
            red[0][sg][lane / 4u + 8u] = acc0_1;
            red[1][sg][lane / 4u] = acc1_0;
            red[1][sg][lane / 4u + 8u] = acc1_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 32u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            const uint out_tn = (col_idx == 0u) ? tn0 : tn1;
            y[sk * N + out_tn * 16u + out_lane] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_2col_sk4(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    const uint pairs_n = tiles_n / 2u;
    constexpr int SG = 8;
    constexpr uint SK = 4u;
    threadgroup float red[2][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint total_groups = pairs_n * SK;
    for (uint tg = tgid; tg < total_groups; tg += ntg) {
        const uint tn = tg % pairs_n;
        const uint sk = tg / pairs_n;

        const uint k_per_split = tiles_k / SK;
        const uint k_start = sk * k_per_split;
        const uint k_end = k_start + k_per_split;

        const uint tn0 = tn * 2u;
        const uint tn1 = tn0 + 1u;

        float acc0_0 = 0.0f;
        float acc0_1 = 0.0f;
        float acc1_0 = 0.0f;
        float acc1_1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn0 * (tiles_k * WORDS);
        const device uint *col1 = (const device uint *)packed + tn1 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 2u;
        const uint k_unroll_end = k_start + ((k_end - k_start) / step) * step;

        uint tk = k_start + sg * 2u;
        for (; tk + step < k_unroll_end; tk += 2u * step) {
            // First trip of the pair — tiles tk, tk+1 (order preserved).
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;

            float v[8];

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];

            extract_v_mcg_32(w0_0_0, w0_0_1, sh0, rsh0, v);
            acc0_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc0_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_0_0, w1_0_1, sh0, rsh0, v);
            acc0_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc0_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(w0_1_0, w0_1_1, sh0, rsh0, v);
            acc1_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_1_0, w1_1_1, sh0, rsh0, v);
            acc1_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            // Second trip of the pair — tiles tk+step, tk+step+1 (order preserved).
            {
                const uint tkx = tk + step;
                const device half *xr0b = x + (tkx + 0u) * 16u + r0;
                const float q00 = float(xr0b[0]), q01 = float(xr0b[1]), q02 = float(xr0b[8]), q03 = float(xr0b[9]);
                const device half *xr1b = x + (tkx + 1u) * 16u + r0;
                const float q10 = float(xr1b[0]), q11 = float(xr1b[1]), q12 = float(xr1b[8]), q13 = float(xr1b[9]);

                const device uint *u0_0 = col0 + (tkx + 0u) * stride;
                const device uint *u1_0 = col0 + (tkx + 1u) * stride;
                const device uint *u0_1 = col1 + (tkx + 0u) * stride;
                const device uint *u1_1 = col1 + (tkx + 1u) * stride;

                const uint x0_0_0 = u0_0[j0], x0_0_1 = u0_0[j1];
                const uint x1_0_0 = u1_0[j0], x1_0_1 = u1_0[j1];
                const uint x0_1_0 = u0_1[j0], x0_1_1 = u0_1[j1];
                const uint x1_1_0 = u1_1[j0], x1_1_1 = u1_1[j1];

                extract_v_mcg_32(x0_0_0, x0_0_1, sh0, rsh0, v);
                acc0_0 += q00 * v[0] + q01 * v[1] + q02 * v[2] + q03 * v[3];
                acc0_1 += q00 * v[4] + q01 * v[5] + q02 * v[6] + q03 * v[7];

                extract_v_mcg_32(x1_0_0, x1_0_1, sh0, rsh0, v);
                acc0_0 += q10 * v[0] + q11 * v[1] + q12 * v[2] + q13 * v[3];
                acc0_1 += q10 * v[4] + q11 * v[5] + q12 * v[6] + q13 * v[7];

                extract_v_mcg_32(x0_1_0, x0_1_1, sh0, rsh0, v);
                acc1_0 += q00 * v[0] + q01 * v[1] + q02 * v[2] + q03 * v[3];
                acc1_1 += q00 * v[4] + q01 * v[5] + q02 * v[6] + q03 * v[7];

                extract_v_mcg_32(x1_1_0, x1_1_1, sh0, rsh0, v);
                acc1_0 += q10 * v[0] + q11 * v[1] + q12 * v[2] + q13 * v[3];
                acc1_1 += q10 * v[4] + q11 * v[5] + q12 * v[6] + q13 * v[7];
            }
        }

        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;

            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;

            float v[8];

            const uint w0_0_0 = t0_0[j0], w0_0_1 = t0_0[j1];
            const uint w1_0_0 = t1_0[j0], w1_0_1 = t1_0[j1];
            const uint w0_1_0 = t0_1[j0], w0_1_1 = t0_1[j1];
            const uint w1_1_0 = t1_1[j0], w1_1_1 = t1_1[j1];

            extract_v_mcg_32(w0_0_0, w0_0_1, sh0, rsh0, v);
            acc0_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc0_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_0_0, w1_0_1, sh0, rsh0, v);
            acc0_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc0_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(w0_1_0, w0_1_1, sh0, rsh0, v);
            acc1_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(w1_1_0, w1_1_1, sh0, rsh0, v);
            acc1_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < k_end; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_0 = col0 + tk * stride;
            const uint a0_0 = t0_0[j0], a1_0 = t0_0[j1];
            float v_0[8];
            extract_v_mcg_32(a0_0, a1_0, sh0, rsh0, v_0);
            acc0_0 += p0 * v_0[0] + p1 * v_0[1] + p2 * v_0[2] + p3 * v_0[3];
            acc0_1 += p0 * v_0[4] + p1 * v_0[5] + p2 * v_0[6] + p3 * v_0[7];

            const device uint *t0_1 = col1 + tk * stride;
            const uint a0_1 = t0_1[j0], a1_1 = t0_1[j1];
            float v_1[8];
            extract_v_mcg_32(a0_1, a1_1, sh0, rsh0, v_1);
            acc1_0 += p0 * v_1[0] + p1 * v_1[1] + p2 * v_1[2] + p3 * v_1[3];
            acc1_1 += p0 * v_1[4] + p1 * v_1[5] + p2 * v_1[6] + p3 * v_1[7];
        }

        acc0_0 += simd_shuffle_xor(acc0_0, 1u);
        acc0_0 += simd_shuffle_xor(acc0_0, 2u);
        acc0_1 += simd_shuffle_xor(acc0_1, 1u);
        acc0_1 += simd_shuffle_xor(acc0_1, 2u);

        acc1_0 += simd_shuffle_xor(acc1_0, 1u);
        acc1_0 += simd_shuffle_xor(acc1_0, 2u);
        acc1_1 += simd_shuffle_xor(acc1_1, 1u);
        acc1_1 += simd_shuffle_xor(acc1_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc0_0;
            red[0][sg][lane / 4u + 8u] = acc0_1;
            red[1][sg][lane / 4u] = acc1_0;
            red[1][sg][lane / 4u + 8u] = acc1_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 32u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            const uint out_tn = (col_idx == 0u) ? tn0 : tn1;
            y[sk * N + out_tn * 16u + out_lane] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_4col(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    const uint quads_n = tiles_n / 4u;
    constexpr int SG = 8;
    threadgroup float red[4][SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < quads_n; tn += ntg) {
        const uint tn0 = tn * 4u;
        const uint tn1 = tn0 + 1u;
        const uint tn2 = tn0 + 2u;
        const uint tn3 = tn0 + 3u;

        float acc0_0 = 0.0f;
        float acc0_1 = 0.0f;
        float acc1_0 = 0.0f;
        float acc1_1 = 0.0f;
        float acc2_0 = 0.0f;
        float acc2_1 = 0.0f;
        float acc3_0 = 0.0f;
        float acc3_1 = 0.0f;

        const device uint *col0 = (const device uint *)packed + tn0 * (tiles_k * WORDS);
        const device uint *col1 = (const device uint *)packed + tn1 * (tiles_k * WORDS);
        const device uint *col2 = (const device uint *)packed + tn2 * (tiles_k * WORDS);
        const device uint *col3 = (const device uint *)packed + tn3 * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 4u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 4u;
        for (; tk < k_unroll_end; tk += step) {
            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
            const device half *xr2 = x + (tk + 2u) * 16u + r0;
            const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
            const device half *xr3 = x + (tk + 3u) * 16u + r0;
            const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

            const device uint *t0_0 = col0 + (tk + 0u) * stride;
            const device uint *t1_0 = col0 + (tk + 1u) * stride;
            const device uint *t2_0 = col0 + (tk + 2u) * stride;
            const device uint *t3_0 = col0 + (tk + 3u) * stride;

            const device uint *t0_1 = col1 + (tk + 0u) * stride;
            const device uint *t1_1 = col1 + (tk + 1u) * stride;
            const device uint *t2_1 = col1 + (tk + 2u) * stride;
            const device uint *t3_1 = col1 + (tk + 3u) * stride;

            const device uint *t0_2 = col2 + (tk + 0u) * stride;
            const device uint *t1_2 = col2 + (tk + 1u) * stride;
            const device uint *t2_2 = col2 + (tk + 2u) * stride;
            const device uint *t3_2 = col2 + (tk + 3u) * stride;

            const device uint *t0_3 = col3 + (tk + 0u) * stride;
            const device uint *t1_3 = col3 + (tk + 1u) * stride;
            const device uint *t2_3 = col3 + (tk + 2u) * stride;
            const device uint *t3_3 = col3 + (tk + 3u) * stride;

            float v[8];

            // Col 0: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_0[j0], t0_0[j1], sh0, rsh0, v);
            acc0_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc0_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_0[j0], t1_0[j1], sh0, rsh0, v);
            acc0_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc0_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_0[j0], t2_0[j1], sh0, rsh0, v);
            acc0_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc0_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_0[j0], t3_0[j1], sh0, rsh0, v);
            acc0_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc0_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];

            // Col 1: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_1[j0], t0_1[j1], sh0, rsh0, v);
            acc1_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_1[j0], t1_1[j1], sh0, rsh0, v);
            acc1_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc1_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_1[j0], t2_1[j1], sh0, rsh0, v);
            acc1_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc1_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_1[j0], t3_1[j1], sh0, rsh0, v);
            acc1_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc1_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];

            // Col 2: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_2[j0], t0_2[j1], sh0, rsh0, v);
            acc2_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc2_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_2[j0], t1_2[j1], sh0, rsh0, v);
            acc2_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc2_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_2[j0], t2_2[j1], sh0, rsh0, v);
            acc2_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc2_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_2[j0], t3_2[j1], sh0, rsh0, v);
            acc2_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc2_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];

            // Col 3: 4 contiguous sub-steps along K
            extract_v_mcg_32(t0_3[j0], t0_3[j1], sh0, rsh0, v);
            acc3_0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc3_1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];

            extract_v_mcg_32(t1_3[j0], t1_3[j1], sh0, rsh0, v);
            acc3_0 += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
            acc3_1 += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];

            extract_v_mcg_32(t2_3[j0], t2_3[j1], sh0, rsh0, v);
            acc3_0 += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
            acc3_1 += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];

            extract_v_mcg_32(t3_3[j0], t3_3[j1], sh0, rsh0, v);
            acc3_0 += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
            acc3_1 += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);

            const device uint *t0_0 = col0 + tk * stride;
            float v_0[8];
            extract_v_mcg_32(t0_0[j0], t0_0[j1], sh0, rsh0, v_0);
            acc0_0 += p0 * v_0[0] + p1 * v_0[1] + p2 * v_0[2] + p3 * v_0[3];
            acc0_1 += p0 * v_0[4] + p1 * v_0[5] + p2 * v_0[6] + p3 * v_0[7];

            const device uint *t0_1 = col1 + tk * stride;
            float v_1[8];
            extract_v_mcg_32(t0_1[j0], t0_1[j1], sh0, rsh0, v_1);
            acc1_0 += p0 * v_1[0] + p1 * v_1[1] + p2 * v_1[2] + p3 * v_1[3];
            acc1_1 += p0 * v_1[4] + p1 * v_1[5] + p2 * v_1[6] + p3 * v_1[7];

            const device uint *t0_2 = col2 + tk * stride;
            float v_2[8];
            extract_v_mcg_32(t0_2[j0], t0_2[j1], sh0, rsh0, v_2);
            acc2_0 += p0 * v_2[0] + p1 * v_2[1] + p2 * v_2[2] + p3 * v_2[3];
            acc2_1 += p0 * v_2[4] + p1 * v_2[5] + p2 * v_2[6] + p3 * v_2[7];

            const device uint *t0_3 = col3 + tk * stride;
            float v_3[8];
            extract_v_mcg_32(t0_3[j0], t0_3[j1], sh0, rsh0, v_3);
            acc3_0 += p0 * v_3[0] + p1 * v_3[1] + p2 * v_3[2] + p3 * v_3[3];
            acc3_1 += p0 * v_3[4] + p1 * v_3[5] + p2 * v_3[6] + p3 * v_3[7];
        }

        acc0_0 += simd_shuffle_xor(acc0_0, 1u);
        acc0_0 += simd_shuffle_xor(acc0_0, 2u);
        acc0_1 += simd_shuffle_xor(acc0_1, 1u);
        acc0_1 += simd_shuffle_xor(acc0_1, 2u);

        acc1_0 += simd_shuffle_xor(acc1_0, 1u);
        acc1_0 += simd_shuffle_xor(acc1_0, 2u);
        acc1_1 += simd_shuffle_xor(acc1_1, 1u);
        acc1_1 += simd_shuffle_xor(acc1_1, 2u);

        acc2_0 += simd_shuffle_xor(acc2_0, 1u);
        acc2_0 += simd_shuffle_xor(acc2_0, 2u);
        acc2_1 += simd_shuffle_xor(acc2_1, 1u);
        acc2_1 += simd_shuffle_xor(acc2_1, 2u);

        acc3_0 += simd_shuffle_xor(acc3_0, 1u);
        acc3_0 += simd_shuffle_xor(acc3_0, 2u);
        acc3_1 += simd_shuffle_xor(acc3_1, 1u);
        acc3_1 += simd_shuffle_xor(acc3_1, 2u);

        if (lane % 4u == 0u) {
            red[0][sg][lane / 4u] = acc0_0;
            red[0][sg][lane / 4u + 8u] = acc0_1;
            red[1][sg][lane / 4u] = acc1_0;
            red[1][sg][lane / 4u + 8u] = acc1_1;
            red[2][sg][lane / 4u] = acc2_0;
            red[2][sg][lane / 4u + 8u] = acc2_1;
            red[3][sg][lane / 4u] = acc3_0;
            red[3][sg][lane / 4u + 8u] = acc3_1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 64u) {
            const uint col_idx = lid / 16u;
            const uint out_lane = lid % 16u;
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[col_idx][g][out_lane];
            }
            const uint out_tn = tn0 + col_idx;
            y[out_tn * 16u + out_lane] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_contig4_sk2(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    constexpr uint SK = 2u;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint tn = tgid % tiles_n;
    const uint sk = tgid / tiles_n;
    if (sk >= SK) return;

    const uint k_per_split = ((tiles_k / SK) / 32u) * 32u;
    const uint k_start = sk * k_per_split;
    const uint k_end = (sk == SK - 1u) ? tiles_k : (k_start + k_per_split);

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    const uint step = SG * 4u;
    const uint k_unroll_end = k_start + ((k_end - k_start) / step) * step;

    uint tk = k_start + sg * 4u;
    for (; tk < k_unroll_end; tk += step) {
        const device uint *t0 = column + (tk + 0u) * stride;
        const device uint *t1 = column + (tk + 1u) * stride;
        const device uint *t2 = column + (tk + 2u) * stride;
        const device uint *t3 = column + (tk + 3u) * stride;

        const ulong w0a = t0[j0], w0b = t0[j1];
        const ulong w1a = t1[j0], w1b = t1[j1];
        const ulong w2a = t2[j0], w2b = t2[j1];
        const ulong w3a = t3[j0], w3b = t3[j1];

        const ulong A0 = ((w0a << 32) | w0b) << sh0;
        const ulong A1 = ((w1a << 32) | w1b) << sh0;
        const ulong A2 = ((w2a << 32) | w2b) << sh0;
        const ulong A3 = ((w3a << 32) | w3b) << sh0;

        const device half *xr0 = x + (tk + 0u) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1u) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
        const device half *xr2 = x + (tk + 2u) * 16u + r0;
        const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
        const device half *xr3 = x + (tk + 3u) * 16u + r0;
        const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

        float v0[8], v1[8], v2[8], v3[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v0[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
            v1[i] = decode_state_mcg(uint(A1 >> (64u - rad)) & 0xffffu);
            v2[i] = decode_state_mcg(uint(A2 >> (64u - rad)) & 0xffffu);
            v3[i] = decode_state_mcg(uint(A3 >> (64u - rad)) & 0xffffu);
        }

        acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
        acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
        acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
        acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
        acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
        acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
        acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
        acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
    }

    for (tk = k_unroll_end + sg; tk < k_end; tk += SG) {
        const device uint *t0 = column + tk * stride;
        const ulong a0 = t0[j0], a1 = t0[j1];
        const ulong A0 = ((a0 << 32) | a1) << sh0;
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
        }
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[(sk * N) + tn * 16u + lid] = sum;
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_contig4_sk4(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    constexpr uint SK = 4u;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint tn = tgid % tiles_n;
    const uint sk = tgid / tiles_n;
    if (sk >= SK) return;

    const uint k_per_split = ((tiles_k / SK) / 32u) * 32u;
    const uint k_start = sk * k_per_split;
    const uint k_end = (sk == SK - 1u) ? tiles_k : (k_start + k_per_split);

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
    const uint stride = WORDS;

    const uint step = SG * 4u;
    const uint k_unroll_end = k_start + ((k_end - k_start) / step) * step;

    uint tk = k_start + sg * 4u;
    for (; tk < k_unroll_end; tk += step) {
        const device uint *t0 = column + (tk + 0u) * stride;
        const device uint *t1 = column + (tk + 1u) * stride;
        const device uint *t2 = column + (tk + 2u) * stride;
        const device uint *t3 = column + (tk + 3u) * stride;

        const ulong w0a = t0[j0], w0b = t0[j1];
        const ulong w1a = t1[j0], w1b = t1[j1];
        const ulong w2a = t2[j0], w2b = t2[j1];
        const ulong w3a = t3[j0], w3b = t3[j1];

        const ulong A0 = ((w0a << 32) | w0b) << sh0;
        const ulong A1 = ((w1a << 32) | w1b) << sh0;
        const ulong A2 = ((w2a << 32) | w2b) << sh0;
        const ulong A3 = ((w3a << 32) | w3b) << sh0;

        const device half *xr0 = x + (tk + 0u) * 16u + r0;
        const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
        const device half *xr1 = x + (tk + 1u) * 16u + r0;
        const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
        const device half *xr2 = x + (tk + 2u) * 16u + r0;
        const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
        const device half *xr3 = x + (tk + 3u) * 16u + r0;
        const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

        float v0[8], v1[8], v2[8], v3[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v0[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
            v1[i] = decode_state_mcg(uint(A1 >> (64u - rad)) & 0xffffu);
            v2[i] = decode_state_mcg(uint(A2 >> (64u - rad)) & 0xffffu);
            v3[i] = decode_state_mcg(uint(A3 >> (64u - rad)) & 0xffffu);
        }

        acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
        acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
        acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
        acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
        acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
        acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
        acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
        acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
    }

    for (tk = k_unroll_end + sg; tk < k_end; tk += SG) {
        const device uint *t0 = column + tk * stride;
        const ulong a0 = t0[j0], a1 = t0[j1];
        const ulong A0 = ((a0 << 32) | a1) << sh0;
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            v[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
        }
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[(sk * N) + tn * 16u + lid] = sum;
    }
}

kernel void linear_gemv_ishizuki_k3_colmajor_u4(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 3u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    threadgroup uint tg_tiles[SG][96]; // 96 words = 4 tiles per SG

    const uint r0 = (lane % 4u) * 2u;
    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    const uint tn = tgid;
    if (tn >= tiles_n) return;

    float acc0 = 0.0f;
    float acc1 = 0.0f;
    const device uint *col_u32 = (const device uint *)packed + tn * (tiles_k * WORDS);
    const device uint4 *col_u4 = (const device uint4 *)col_u32;

    const uint k_unroll_end = (tiles_k / (SG * 4u)) * (SG * 4u);
    uint tk = sg * 4u;
    for (; tk < k_unroll_end; tk += SG * 4u) {
        const uint u4_offset = tk * 6u;
        if (lane < 24u) {
            uint4 u = col_u4[u4_offset + lane];
            tg_tiles[sg][lane * 4u + 0u] = u.x;
            tg_tiles[sg][lane * 4u + 1u] = u.y;
            tg_tiles[sg][lane * 4u + 2u] = u.z;
            tg_tiles[sg][lane * 4u + 3u] = u.w;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        #pragma unroll
        for (uint t = 0; t < 4u; ++t) {
            threadgroup const uint *t0 = tg_tiles[sg] + t * 24u;
            const ulong w0a = t0[j0], w0b = t0[j1];
            const ulong A0 = ((w0a << 32) | w0b) << sh0;

            const device half *xr0 = x + (tk + t) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);

            float v[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint r = i * KA + 16u;
                v[i] = decode_state_mcg(uint(A0 >> (64u - r)) & 0xffffu);
            }
            acc0 += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
            acc1 += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    // Trailing tiles
    for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
        const device uint *t0 = col_u32 + tk * WORDS;
        const ulong a0 = t0[j0], a1 = t0[j1];
        const ulong A0 = ((a0 << 32) | a1) << sh0;
        const device half *xr0 = x + tk * 16u + r0;
        const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
        float v[8];
        #pragma unroll
        for (uint i = 0; i < 8u; ++i) {
            const uint rad = i * KA + 16u;
            const uint s = uint(A0 >> (64u - rad));
            v[i] = decode_state_mcg(s & 0xffffu);
        }
        acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
        acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
    }

    acc0 += simd_shuffle_xor(acc0, 1u);
    acc0 += simd_shuffle_xor(acc0, 2u);
    acc1 += simd_shuffle_xor(acc1, 1u);
    acc1 += simd_shuffle_xor(acc1, 2u);
    if (lane % 4u == 0u) {
        red[sg][lane / 4u] = acc0;
        red[sg][lane / 4u + 8u] = acc1;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lid < 16u) {
        float sum = 0.0f;
        for (int g = 0; g < SG; ++g) {
            sum += red[g][lid];
        }
        y[tn * 16u + lid] = sum;
    }
}

// ---------------------------------------------------------------------------
// MEASUREMENT KERNEL, NOT A DECODE PATH: 4 bpw on the `_contig4` colmajor body.
// ---------------------------------------------------------------------------
//
// WHY IT EXISTS. Every colmajor decode kernel in this file is 3 bpw, and
// `exl3::reorder_tensor_to_colmajor` hardcodes 48 u16 (= 24 32-bit words) per
// tile, so a 4 bpw colmajor tensor cannot even be built by the production
// repacker. That makes 3 bpw the only rate this path can be measured at, which
// is what leaves the following question open:
//
//   is the 3 bpw colmajor decode's ~188 GB/s (spec/decode-19tok-repacked-250gb,
//   `gate_up_gelu`, fit error 0.1% against `250.5 x 2.00/2.667`) the EXL3 *rate*,
//   or a kernel defect that would show at every rate?
//
// Answering it needs the same body at two rates. This is that body at KA = 4,
// character-for-character identical to `linear_gemv_ishizuki_k3_colmajor_contig4`
// except for three constants (`KA`, and the two derived from it: `RING`, `WORDS`)
// and one literal (`lo0`'s `* 3u` -> `* KA`).
//
// THE NAME IS DELIBERATE, AND IT IS THE SAFETY ARGUMENT.
// `ishizuki_gemv_pipeline` (linear.rs) selects a production decode kernel by
// *exact HashMap key* on one of four names:
//
//     linear_gemv_ishizuki_k{bits}_colmajor_contig4
//     linear_gemv_ishizuki_k{bits}_colmajor
//     linear_gemv_ishizuki_k{bits}_w2
//     <the sorted-first kernel naming that rate>          (the slot table)
//
// The first key is the dangerous one: it is built from a format string, so a
// kernel named `..._k4_colmajor_contig4` would be picked up by a 4 bpw
// `perm_mode == 1` tensor. Naming it `..._contig4_bench` means no `get()` can
// ever match it. The slot table is safe for the complementary reason:
// `ishizuki_kernel_names` sorts, and `linear_gemv_ishizuki_k4` is a prefix of this
// name, so the unsuffixed kernel claims slot 4 first. Both halves are asserted by
// `crates/engine/tests/rate4_colmajor_bit_exact.rs`.
//
//   * Nothing in the engine dispatches this kernel, and nothing can: the model
//     is 3 bpw for all seven per-layer linears and 6 bpw (row-major,
//     `perm_mode = 0`) for `lm_head`, and the repacker can only ever emit 3 bpw
//     colmajor tiles.
//   * `scripts/gen_exl3_gemv.py` rewrites `linear.metal` only, so this file is
//     outside the generated block (spec AC6: generator twice -> clean diff).
//
// WHY TWO WORDS PER LANE IS CORRECT AT 4 bpW -- derived, not assumed, and the
// derivation has TWO failure conditions, not one.
// The two-word form `A0 = ((w0 << 32) | w1) << sh` fills A0 bits `[sh, 64)` from
// the pair and leaves `[0, sh)` zero. Code `i` reads A0 bits `[64 - r, 80 - r)`
// with `r = i*KA + 16`, so the lowest bit any code touches is `48 - 7*KA` and the
// pair suffices exactly when
//
//     (a) 7*KA + 16 <= 64          (no code falls through to B0)   AND
//     (b) max over lanes of sh <= 48 - 7*KA   (no code reads below its own sh)
//
// (b) is the one that bites. At KA = 4, `sh` is 20 for every lane
// (`(lane*8+1)*4 - 16` is constant mod 32) and `48 - 28 = 20`, so the two-word
// form is legal **exactly on the boundary**. `WORDS = RING/32 = 32` -- 64 u16 per
// tile, against the 48 u16 (24 words) that `exl3::reorder_tensor_to_colmajor`
// hardcodes, which is why the 4 bpw colmajor repack has to be built separately.
//
// The same derivation is in `unpack_integer` (crates/engine/src/exl3.rs:231-280)
// and, stated as both failure conditions, in `two_word_is_safe` in
// `scripts/gen_exl3_gemv.py`, whose `TWO_WORD_SAFE_RATES` evaluates to
// (1, 2, 3, 4). `crates/engine/tests/rate4_colmajor_bit_exact.rs` measures
// 2-word against 3-word at every rate 1..=8 and pins that set.
//
// I first wrote (a) alone and concluded "KA <= 6, so 4 bpw needs two words". (a)
// alone is not sufficient, and the 6 bpw kernel below is where that showed up.
//
// CONSEQUENCE FOR BANDWIDTH, the point of the measurement: a lane loads
// 2 x 4 B = 8 B and consumes `8 * KA` bits, so lane-load amplification per useful
// byte is `8 / KA` -- **2.667 at 3 bpw, 2.000 at 4 bpw**. If 3 bpw is slow
// because of the rate, 4 bpw on this body should be 2.667/2.000 = 1.333x faster.
// If 4 bpw is slow by the same factor, the stall is rate-independent and there is
// headroom in the kernel.
//
// `constexpr int CB` is carried over verbatim from the kernel it is copied from,
// where it is likewise unused: `decode_state_mcg` is called directly, which is the
// whole point of the specialisation documented at linear.metal:310-343.
kernel void linear_gemv_ishizuki_k4_colmajor_contig4_bench(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 4u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * KA + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
        float acc0 = 0.0f;
        float acc1 = 0.0f;
        const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 4u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 4u;
        for (; tk < k_unroll_end; tk += step) {
            const device uint *t0 = column + (tk + 0u) * stride;
            const device uint *t1 = column + (tk + 1u) * stride;
            const device uint *t2 = column + (tk + 2u) * stride;
            const device uint *t3 = column + (tk + 3u) * stride;

            const ulong w0a = t0[j0], w0b = t0[j1];
            const ulong w1a = t1[j0], w1b = t1[j1];
            const ulong w2a = t2[j0], w2b = t2[j1];
            const ulong w3a = t3[j0], w3b = t3[j1];

            const ulong A0 = ((w0a << 32) | w0b) << sh0;
            const ulong A1 = ((w1a << 32) | w1b) << sh0;
            const ulong A2 = ((w2a << 32) | w2b) << sh0;
            const ulong A3 = ((w3a << 32) | w3b) << sh0;

            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
            const device half *xr2 = x + (tk + 2u) * 16u + r0;
            const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
            const device half *xr3 = x + (tk + 3u) * 16u + r0;
            const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

            float v0[8], v1[8], v2[8], v3[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint rad = i * KA + 16u;
                v0[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
                v1[i] = decode_state_mcg(uint(A1 >> (64u - rad)) & 0xffffu);
                v2[i] = decode_state_mcg(uint(A2 >> (64u - rad)) & 0xffffu);
                v3[i] = decode_state_mcg(uint(A3 >> (64u - rad)) & 0xffffu);
            }

            acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
            acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
            acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
            acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
            acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
            acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
            acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
            acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device uint *t0 = column + tk * stride;
            const ulong a0 = t0[j0], a1 = t0[j1];
            const ulong A0 = ((a0 << 32) | a1) << sh0;
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
            float v[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint rad = i * KA + 16u;
                const uint s = uint(A0 >> (64u - rad));
                v[i] = decode_state_mcg(s & 0xffffu);
            }
            acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
            acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
        }

        acc0 += simd_shuffle_xor(acc0, 1u);
        acc0 += simd_shuffle_xor(acc0, 2u);
        acc1 += simd_shuffle_xor(acc1, 1u);
        acc1 += simd_shuffle_xor(acc1, 2u);
        if (lane % 4u == 0u) {
            red[sg][lane / 4u] = acc0;
            red[sg][lane / 4u + 8u] = acc1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 16u) {
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[g][lid];
            }
            y[tn * 16u + lid] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

// ---------------------------------------------------------------------------
// MEASUREMENT KERNEL, NOT A DECODE PATH: 6 bpw on the colmajor contig4 body.
// ---------------------------------------------------------------------------
//
// WHY IT EXISTS. `lm_head` is 6 bpw and measured 250.5 GB/s in situ
// (spec/decode-19tok-repacked-250gb), and the spec attributes that to it being at
// lane-load amplification 2.000 rather than 2.667. That is a claim about the
// *ratio*, and the 4 bpw arm below now supplies the missing half: 4 bpw is also
// amplification 2.000, so 4 bpw colmajor and 6 bpw row-major differ in rate but
// not in requests. If both land at the same number, amplification explains the
// 3 bpw gap and the rate does not; if they differ, something rate-dependent is
// still in the picture.
//
// THIS ONE NEEDS THREE WORDS PER LANE, NOT TWO, and that is the whole point of
// deriving it rather than copying the 4 bpw kernel.
//
// The two-word form `A0 = ((w0 << 32) | w1) << sh` fills A0 bits `[sh, 64)` from
// the pair and leaves `[0, sh)` zero. A code `i` reads A0 bits
// `[64 - r, 80 - r)` with `r = i*KA + 16`, so the lowest bit any code touches is
// `48 - 7*KA` and the third word is dead exactly when
//
//     max over lanes of sh  <=  48 - 7*KA
//
// At KA = 6: `sh in {6, 22}` (only four distinct `lane*8+1` residues mod 32
// exist), so max is 22, while `48 - 42 = 6`. 22 > 6, and every lane with sh = 22
// reads six bits of zeros as if they were weight.
//
// That is not a subtlety I worked out and then checked. The first version of this
// kernel was a literal copy of the 4 bpw one and it decoded garbage -- 1023 of
// 1024 fp16 outputs wrong at 128x1024, caught by
// `crates/engine/tests/rate4_colmajor_bit_exact.rs`, which holds the 3 bpw
// *production* kernel to 0 ULP from the same CPU reference and therefore makes
// "the reference is wrong" a distinguishable alternative. The repo already had
// the correct derivation: `two_word_is_safe` in `scripts/gen_exl3_gemv.py`
// states both failure conditions, and `TWO_WORD_SAFE_RATES` comes out as
// (1, 2, 3, 4). Note that 3 bpw and 4 bpw sit exactly *on* the boundary
// (27 <= 27 and 20 <= 20) -- the two-word form is legal there only because the
// lowest bit read coincides with the first valid bit. `rate4_colmajor_bit_exact.rs`
// pins that set by measuring 2-word against 3-word at every rate 1..=8.
//
// CONSEQUENCE FOR THE MEASUREMENT, stated so it cannot be misread:
//   rate    words/lane    amplification
//   3 bpw      2             2.667
//   4 bpw      2             2.000
//   6 bpw      3             2.000
//
// So the 6 bpw arm is NOT a lower-amplification point. It is a
// same-amplification / different-rate control, and the ratio to report against
// 3 bpw is 2.667/2.000 = 1.333 for *both* 4 bpw and 6 bpw -- if the
// amplification model holds.
//
// `constexpr int CB` is carried over from the kernel this is transcribed from,
// where it is likewise unused: `decode_state_mcg` is called directly.
kernel void linear_gemv_ishizuki_k6_colmajor_contig4_bench(
    const device ushort *packed [[buffer(0)]],
    const device half *x [[buffer(1)]],
    device float *y [[buffer(2)]],
    constant const uint *shape [[buffer(3)]],
    uint lid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint tgid [[threadgroup_position_in_grid]],
    uint ntg [[threadgroups_per_grid]]) {
    constexpr uint KA = 6u;
    constexpr int CB = 1;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    threadgroup float red[SG][16];
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * KA + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;
    // `j1 + 1` reduced modulo WORDS. The `: j0` in linear.metal's `else` arm of
    // `linear_gemv_ishizuki_k*` is `j0` where `j1 + 1` belongs; it is latent
    // there (Metal reports it as `unused variable 'j2'`, because at those rates
    // no code reads A0 below its own `sh`), and at 6 bpw it would be read on
    // every lane with `j0 < WORDS - 2`. Corrected here rather than copied.
    const uint j2 = j1 + 1u >= WORDS ? j1 + 1u - WORDS : j1 + 1u;

    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
        float acc0 = 0.0f;
        float acc1 = 0.0f;
        const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 4u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 4u;
        for (; tk < k_unroll_end; tk += step) {
            const device uint *t0 = column + (tk + 0u) * stride;
            const device uint *t1 = column + (tk + 1u) * stride;
            const device uint *t2 = column + (tk + 2u) * stride;
            const device uint *t3 = column + (tk + 3u) * stride;

            const ulong w0a = t0[j0], w0b = t0[j1], w0c = t0[j2];
            const ulong w1a = t1[j0], w1b = t1[j1], w1c = t1[j2];
            const ulong w2a = t2[j0], w2b = t2[j1], w2c = t2[j2];
            const ulong w3a = t3[j0], w3b = t3[j1], w3c = t3[j2];

            const ulong A0 = ((w0a << 32) | w0b) << sh0 | (sh0 ? (w0c >> (32 - sh0)) : 0ul);
            const ulong A1 = ((w1a << 32) | w1b) << sh0 | (sh0 ? (w1c >> (32 - sh0)) : 0ul);
            const ulong A2 = ((w2a << 32) | w2b) << sh0 | (sh0 ? (w2c >> (32 - sh0)) : 0ul);
            const ulong A3 = ((w3a << 32) | w3b) << sh0 | (sh0 ? (w3c >> (32 - sh0)) : 0ul);

            const device half *xr0 = x + (tk + 0u) * 16u + r0;
            const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
            const device half *xr1 = x + (tk + 1u) * 16u + r0;
            const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
            const device half *xr2 = x + (tk + 2u) * 16u + r0;
            const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
            const device half *xr3 = x + (tk + 3u) * 16u + r0;
            const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);

            float v0[8], v1[8], v2[8], v3[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint rad = i * KA + 16u;
                v0[i] = decode_state_mcg(uint(A0 >> (64u - rad)) & 0xffffu);
                v1[i] = decode_state_mcg(uint(A1 >> (64u - rad)) & 0xffffu);
                v2[i] = decode_state_mcg(uint(A2 >> (64u - rad)) & 0xffffu);
                v3[i] = decode_state_mcg(uint(A3 >> (64u - rad)) & 0xffffu);
            }

            acc0 += p00 * v0[0] + p01 * v0[1] + p02 * v0[2] + p03 * v0[3];
            acc1 += p00 * v0[4] + p01 * v0[5] + p02 * v0[6] + p03 * v0[7];
            acc0 += p10 * v1[0] + p11 * v1[1] + p12 * v1[2] + p13 * v1[3];
            acc1 += p10 * v1[4] + p11 * v1[5] + p12 * v1[6] + p13 * v1[7];
            acc0 += p20 * v2[0] + p21 * v2[1] + p22 * v2[2] + p23 * v2[3];
            acc1 += p20 * v2[4] + p21 * v2[5] + p22 * v2[6] + p23 * v2[7];
            acc0 += p30 * v3[0] + p31 * v3[1] + p32 * v3[2] + p33 * v3[3];
            acc1 += p30 * v3[4] + p31 * v3[5] + p32 * v3[6] + p33 * v3[7];
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device uint *t0 = column + tk * stride;
            const ulong a0 = t0[j0], a1 = t0[j1], a2 = t0[j2];
            const ulong A0 = ((a0 << 32) | a1) << sh0 | (sh0 ? (a2 >> (32 - sh0)) : 0ul);
            const device half *xr0 = x + tk * 16u + r0;
            const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
            float v[8];
            #pragma unroll
            for (uint i = 0; i < 8u; ++i) {
                const uint rad = i * KA + 16u;
                const uint s = uint(A0 >> (64u - rad));
                v[i] = decode_state_mcg(s & 0xffffu);
            }
            acc0 += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
            acc1 += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
        }

        acc0 += simd_shuffle_xor(acc0, 1u);
        acc0 += simd_shuffle_xor(acc0, 2u);
        acc1 += simd_shuffle_xor(acc1, 1u);
        acc1 += simd_shuffle_xor(acc1, 2u);
        if (lane % 4u == 0u) {
            red[sg][lane / 4u] = acc0;
            red[sg][lane / 4u + 8u] = acc1;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (lid < 16u) {
            float sum = 0.0f;
            for (int g = 0; g < SG; ++g) {
                sum += red[g][lid];
            }
            y[tn * 16u + lid] = sum;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

// ============================================================================
// Multi-RHS (MRHS) GEMV for Small-Batch High-Bandwidth Prefill
// ============================================================================
// Dispatches M in [1, 32] query vectors concurrently against 3 bpw column-major
// repacked weights. Weights are fetched and dequantized once per tile into registers,
// then accumulated across M query rows with zero threadgroup barriers in the inner
// K-loop, achieving full DRAM streaming bandwidth (~185 GB/s).

template <uint M_CAP>
static inline void linear_gemv_mrhs_ishizuki_k3_colmajor_contig4_impl(
    const device ushort *packed,
    const device half *x,
    device float *y,
    constant const uint *shape,
    uint lid,
    uint lane,
    uint sg,
    uint tgid,
    uint ntg,
    threadgroup float (&red)[8][16]) {
    constexpr uint KA = 3u;
    constexpr uint RING = 256u * KA;
    constexpr uint WORDS = RING / 32u;
    const uint K = shape[0];
    const uint N = shape[1];
    const uint valid_m = shape[2];
    const uint tiles_n = N / 16u;
    const uint tiles_k = K / 16u;
    constexpr int SG = 8;
    const uint r0 = (lane % 4u) * 2u;

    const uint lo0 = (lane * 8u + 1u) * 3u + RING - 16u;
    const uint sh0 = lo0 % 32u;
    const uint rsh0 = 32u - sh0;
    const uint hi0 = lo0 / 32u;
    const uint j0 = hi0 >= WORDS ? hi0 - WORDS : hi0;
    const uint j1 = j0 + 1u >= WORDS ? j0 + 1u - WORDS : j0 + 1u;

    for (uint tn = tgid; tn < tiles_n; tn += ntg) {
        float acc0[M_CAP];
        float acc1[M_CAP];
        #pragma unroll
        for (uint m = 0; m < M_CAP; ++m) {
            acc0[m] = 0.0f;
            acc1[m] = 0.0f;
        }

        const device uint *column = (const device uint *)packed + tn * (tiles_k * WORDS);
        const uint stride = WORDS;

        const uint step = SG * 4u;
        const uint k_unroll_end = (tiles_k / step) * step;

        uint tk = sg * 4u;
        for (; tk < k_unroll_end; tk += step) {
            const device uint *t0 = column + (tk + 0u) * stride;
            const device uint *t1 = column + (tk + 1u) * stride;
            const device uint *t2 = column + (tk + 2u) * stride;
            const device uint *t3 = column + (tk + 3u) * stride;

            float v[8];

            extract_v_mcg_32(t0[j0], t0[j1], sh0, rsh0, v);
            #pragma unroll
            for (uint m = 0; m < M_CAP; ++m) {
                const uint m_clamped = m < valid_m ? m : (valid_m - 1u);
                const device half *xm = x + m_clamped * K;
                const device half *xr0 = xm + (tk + 0u) * 16u + r0;
                const float p00 = float(xr0[0]), p01 = float(xr0[1]), p02 = float(xr0[8]), p03 = float(xr0[9]);
                acc0[m] += p00 * v[0] + p01 * v[1] + p02 * v[2] + p03 * v[3];
                acc1[m] += p00 * v[4] + p01 * v[5] + p02 * v[6] + p03 * v[7];
            }

            extract_v_mcg_32(t1[j0], t1[j1], sh0, rsh0, v);
            #pragma unroll
            for (uint m = 0; m < M_CAP; ++m) {
                const uint m_clamped = m < valid_m ? m : (valid_m - 1u);
                const device half *xm = x + m_clamped * K;
                const device half *xr1 = xm + (tk + 1u) * 16u + r0;
                const float p10 = float(xr1[0]), p11 = float(xr1[1]), p12 = float(xr1[8]), p13 = float(xr1[9]);
                acc0[m] += p10 * v[0] + p11 * v[1] + p12 * v[2] + p13 * v[3];
                acc1[m] += p10 * v[4] + p11 * v[5] + p12 * v[6] + p13 * v[7];
            }

            extract_v_mcg_32(t2[j0], t2[j1], sh0, rsh0, v);
            #pragma unroll
            for (uint m = 0; m < M_CAP; ++m) {
                const uint m_clamped = m < valid_m ? m : (valid_m - 1u);
                const device half *xm = x + m_clamped * K;
                const device half *xr2 = xm + (tk + 2u) * 16u + r0;
                const float p20 = float(xr2[0]), p21 = float(xr2[1]), p22 = float(xr2[8]), p23 = float(xr2[9]);
                acc0[m] += p20 * v[0] + p21 * v[1] + p22 * v[2] + p23 * v[3];
                acc1[m] += p20 * v[4] + p21 * v[5] + p22 * v[6] + p23 * v[7];
            }

            extract_v_mcg_32(t3[j0], t3[j1], sh0, rsh0, v);
            #pragma unroll
            for (uint m = 0; m < M_CAP; ++m) {
                const uint m_clamped = m < valid_m ? m : (valid_m - 1u);
                const device half *xm = x + m_clamped * K;
                const device half *xr3 = xm + (tk + 3u) * 16u + r0;
                const float p30 = float(xr3[0]), p31 = float(xr3[1]), p32 = float(xr3[8]), p33 = float(xr3[9]);
                acc0[m] += p30 * v[0] + p31 * v[1] + p32 * v[2] + p33 * v[3];
                acc1[m] += p30 * v[4] + p31 * v[5] + p32 * v[6] + p33 * v[7];
            }
        }

        for (tk = k_unroll_end + sg; tk < tiles_k; tk += SG) {
            const device uint *t0 = column + tk * stride;
            const uint a0 = t0[j0], a1 = t0[j1];
            float v[8];
            extract_v_mcg_32(a0, a1, sh0, rsh0, v);

            #pragma unroll
            for (uint m = 0; m < M_CAP; ++m) {
                const uint m_clamped = m < valid_m ? m : (valid_m - 1u);
                const device half *xm = x + m_clamped * K;
                const device half *xr0 = xm + tk * 16u + r0;
                const float p0 = float(xr0[0]), p1 = float(xr0[1]), p2 = float(xr0[8]), p3 = float(xr0[9]);
                acc0[m] += p0 * v[0] + p1 * v[1] + p2 * v[2] + p3 * v[3];
                acc1[m] += p0 * v[4] + p1 * v[5] + p2 * v[6] + p3 * v[7];
            }
        }

        #pragma unroll
        for (uint m = 0; m < M_CAP; ++m) {
            acc0[m] += simd_shuffle_xor(acc0[m], 1u);
            acc0[m] += simd_shuffle_xor(acc0[m], 2u);
            acc1[m] += simd_shuffle_xor(acc1[m], 1u);
            acc1[m] += simd_shuffle_xor(acc1[m], 2u);
        }

        for (uint m = 0; m < valid_m; ++m) {
            if (lane % 4u == 0u) {
                red[sg][lane / 4u] = acc0[m];
                red[sg][lane / 4u + 8u] = acc1[m];
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
            if (lid < 16u) {
                float sum = 0.0f;
                for (int g = 0; g < SG; ++g) {
                    sum += red[g][lid];
                }
                y[m * N + tn * 16u + lid] = sum;
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
        }
    }
}

